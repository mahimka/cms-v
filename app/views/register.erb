<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Регистрация — <%= settings.site_name %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/versions/bulma-no-dark-mode.min.css">
</head>
<body>

  <section class="section">
    <div class="container" style="max-width: 420px;">

      <h1 class="title is-4">Регистрация</h1>

      <% if flash.has?(:error_title) %>
        <div class="notification is-warning">
          <strong><%= flash[:error_title] %></strong>
          <% if flash[:errors].present? %>
            <ul>
              <% flash[:errors].each do |e| %>
                <li><%= e %></li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>

      <form method="POST" action="/register">
        <% if params[:redirect_to].present? %>
          <input type="hidden" name="redirect_to" value="<%= params[:redirect_to] %>">
        <% end %>

        <div class="field">
          <label class="label">Имя</label>
          <div class="control">
            <input class="input" type="text" name="name" value="<%= @user&.name %>" required autofocus>
          </div>
        </div>

        <div class="field">
          <label class="label">Email</label>
          <div class="control">
            <input class="input" type="email" name="email" value="<%= @user&.email %>" required>
          </div>
        </div>

        <div class="field">
          <label class="label">Пароль</label>
          <div class="control">
            <input class="input" type="password" name="password" required minlength="8">
          </div>
          <p class="help">Минимум 8 символов</p>
        </div>

        <div class="field">
          <div class="control">
            <button type="submit" class="button is-link">Зарегистрироваться</button>
          </div>
        </div>
      </form>

      <p class="mt-4">
        Уже есть аккаунт?
        <a href="/login<%= params[:redirect_to].present? ? "?redirect_to=#{Rack::Utils.escape(params[:redirect_to])}" : '' %>">Войти</a>
      </p>

    </div>
  </section>

</body>
</html>
