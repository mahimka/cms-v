          </div>

          <!-- Оптимизированная группа кнопок навигации -->
          <div class="field has-addons mt-5 mb-3">
            <!-- Google Maps (Primary Action) -->
            <p class="control is-expanded">
              <a href="https://www.google.com/maps/dir/?api=1&destination=<%= @page.pageable.latitude %>,<%= @page.pageable.longitude %>"
                 target="_blank" 
                 rel="noopener" 
                 class="button is-primary is-medium is-fullwidth has-text-weight-bold">
                <!-- MapPin -->
                <span class="icon mr-1">
                  <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <span>Google Maps</span>
              </a>
            </p>

            <!-- Waze -->
            <p class="control">
              <a href="https://waze.com/ul?ll=<%= @page.pageable.latitude %>,<%= @page.pageable.longitude %>&navigate=yes" 
                 target="_blank" 
                 rel="noopener" 
                 class="button is-info is-medium" 
                 title="Odpri v Waze">
                <!-- Navigation -->
                <span class="icon mr-1">
                  <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                </span>
                <span>Waze</span>
              </a>
            </p>
          </div>

          <div class="buttons mt-5">
            <%= @page.hero_3 %>

            <%= link_on_page('_price') %>
            <%= link_on_page('_gallery') %>
            <%= link_on_page('_what_is_near') %>
            <%= link_on_page('_faq') %>
          </div>

          <%= partial('_share_buttons') %>

        </div>

        <div class="column is-7">
          <%= partial '_picture_pageable' %>
