<% content_for :hero do %>
<section class="hero is-small has-background-grey-lighter mt-0 pb-0">
  <div class="hero-body">
    <div class="container">

      <div class="columns is-vcentered">

        <div class="column is-5">
     
          <h1 class="title title_hero"><%= @page.h1 %></h1>
          <p class='subtitle mb-4'><%= @page.subtitle %></p>
          
          <strong class="is-size-5" style="color:#2c6fad;">€<%= "#{@page_details['rate_low']}" %></strong>  
          <span class="is-size-7 has-text-grey">/ <%= label_by_lang('season_low') %> &nbsp; &nbsp;   -  &nbsp; &nbsp;</span>
          <strong class="is-size-5" style="color:#2c6fad;"> €<%= "#{@page_details['rate_high']}" %> </strong> 
          <span class="is-size-7 has-text-grey">/ <%= label_by_lang('season_high') %></span> 

          <!--<p class="subtitle is-6  mb-5 mt-5" style="opacity: 0.92; max-width: 640px; line-height: 1.7;">-->
            <%= @page.hero_1 %>
          <!--</p>-->

          <div class="tags mt-3 mb-1">
            <%= @page.hero_2 %>
            <% if tag_by_lang('24h Rate') == '' %>
              <span class="tag is-danger is-light has-text-weight-semibold">
                <span class="icon is-small mr-1">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </span>
                Ni 24h tarife
              </span>
            <% else %>
              <%= tag_by_lang('24h Rate') %>
            <% end %>

            <% @page.pageable.tags.where(name: ['24h', 'Electric Charger', 'First 60 Min Free', 'Motorhome']).each do |tag| %>
