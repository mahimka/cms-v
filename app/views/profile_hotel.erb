<% content_for :schema_main_entity do %>

  <%
    technical_detail_keys = %w[thumb_image gallery_old_yaml distance_to_diversorio booking_slug]
    technical_detail_prefixes = %w[price season beds24 panorama hours]
    schema_details = (@page.pageable&.details || {}).reject do |key, _|
      technical_detail_keys.include?(key) || technical_detail_prefixes.any? { |p| key.start_with?(p) }
    end

    # Organization:LodgingBusiness — та же схема, что Organization:FoodEstablishment
    # у ресторанов: дети это реальные имена типов schema.org (Hotel, Hostel,
    # BedAndBreakfast и т.п.). Берём только то, чем сущность реально
    # тегирована — без принудительного LodgingBusiness fallback.
    # LodgingBusiness — общий/родовой тег в этой же группе — убираем его,
    # если есть более конкретный тег рядом; оставляем, только если это
    # единственный тег.
    schema_types = (@page.pageable&.tags&.active || [])
                      .select { |tag| tag.parent&.name == 'Organization:LodgingBusiness' }
                      .map(&:name)
    schema_types -= ['LodgingBusiness'] if schema_types.size > 1

    day_names = {
      'monday' => 'Monday', 'tuesday' => 'Tuesday', 'wednesday' => 'Wednesday',
      'thursday' => 'Thursday', 'friday' => 'Friday', 'saturday' => 'Saturday', 'sunday' => 'Sunday'
    }
    opening_hours = day_names.flat_map do |key, label|
      hours = @page_details["hours_#{key}"]
      next [] if hours.blank? || hours.strip.casecmp('closed').zero?

      hours.split(',').filter_map do |range|
        opens, closes = range.strip.split('-').map(&:strip)
        { day: label, opens: opens, closes: closes } if opens.present? && closes.present?
      end
    end

  %>

  {
    "@type": [<%= schema_types.map { |t| "\"#{t}\"" }.join(', ') %>],
    "@id": "https://<%= settings.domain -%><%= request.path_info %>",
    "name": "<%= json_escape(@page.h1) %>",
    "url": "https://<%= settings.domain -%><%= request.path_info %>",
    "sameAs": [
    <% (@page_links || {}).each_with_index do |(_key, url), index| %>
        "<%= json_escape(url) %>"<%= ',' unless index == @page_links.size - 1 %>
    <% end %>
    ],
    "image": [

    <% pictures = @page.pageable&.pictures&.published || [] %>
    <% pictures.each_with_index do |picture, index| %>
      {
        "@type": "ImageObject",
        "contentUrl": "https://<%= settings.domain %><%= picture.file %>",
        "alternateName": "<%= json_escape(picture.translation(@page.lang)) %>"
      }<%= ',' unless index == pictures.size - 1 %>
    <% end %>
    ],
    "keywords": [<%= (@page.pageable&.tags&.active || []).collect{|tag| json_escape(tag&.name).then { |n| "\"#{n}\"" } }.join(', ') %>],
    <% unless @page.meta_description.blank? %>
    "description": "<%= json_escape(@page.meta_description) %>",
    <% end %>
    <% unless @page_details['telephone'].blank? %>
    "telephone": "<%= json_escape(format_phone_si(@page_details['telephone'])) %>",
    <% end %>
    <% unless @page_details['email'].blank? %>
    "email": "<%= json_escape(@page_details['email']) %>",
    <% end %>
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "<%= json_escape(schema_details['streetAddress']) %>",
      "addressLocality": "<%= json_escape(@page.pageable&.first_tag_of_group('addressLocality', @page.lang)) %>",
      "addressRegion": "<%= json_escape(@page.pageable&.first_tag_of_group('addressRegion', @page.lang)) %>",
      "postalCode": "<%= json_escape(@page.pageable&.first_tag_of_group('postalCode', @page.lang)) %>",
      "addressCountry": "<%= json_escape(@page.pageable&.first_tag_of_group('addressCountry')) %>"
    },
    <% if @page.pageable&.latitude.present? && @page.pageable&.longitude.present? %>
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": <%= @page.pageable.latitude %>,
      "longitude": <%= @page.pageable.longitude %>
    },
    <% end %>
    <% unless opening_hours.empty? %>
    "openingHoursSpecification": [
      <% opening_hours.each_with_index do |oh, index| %>
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "<%= oh[:day] %>",
        "opens": "<%= oh[:opens] %>",
        "closes": "<%= oh[:closes] %>"
      }<%= ',' unless index == opening_hours.size - 1 %>
      <% end %>
    ],
    <% end %>
    "additionalProperty": [
      <% schema_details.each_with_index do |(key, value), index| %>
              {
            "@type": "PropertyValue",
            "name": "<%= json_escape(label_by_lang(key)) %>",
            "value": "<%= json_escape(value) %>"
           }<%= ',' unless index == schema_details.size - 1 %>
      <% end %>
    ]
  }
<% end %>

