<% content_for :hero do %>
<section class="hero is-small has-background-grey-lighter mt-0 pb-0">
  <div class="hero-body">
    <div class="container">

      <div class="columns is-vcentered">

        <div class="column is-5">
     
          <h1 class="title title_hero"><%= @page.h1 %></h1>
          <span class='subtitle '><%= @page.subtitle %></span>
          
          <!--
          <strong class="is-size-6" style="color:#2c6fad;">€<%= "#{@page_details['price_low_season_next_h']}" %></strong>  
          <span class="is-size-7 has-text-grey">/ <%= label_by_lang('season_low') %> &nbsp; &nbsp;   -  &nbsp; &nbsp;</span>
          <strong class="is-size-6" style="color:#2c6fad;"> €<%= "#{@page_details['price_high_season_next_h']}" %> </strong> 
          <span class="is-size-7 has-text-grey">/ <%= label_by_lang('season_high') %></span> 
          -->
          <p class="subtitle is-6  mb-5 mt-5" style="opacity: 0.92; max-width: 640px; line-height: 1.7;">
            <%= @page.hero_1 %>
          </p>

          <div class="tags mb-5">
            <%= @page.hero_2 %>
          </div>


          <div class="tags mt-3  is-light">
            <% @page.source_page.tags.where(name: ['dddddddddddddd', 'ddddddddddddddd', 'dddddddddddddddd', 'ddddddddddddddddd']).each do |tag| %>
              <span class="tag"><%#= tag.icon_svg %><%= tag.localized_name(@page.lang) %></span>
            <% end %>
          </div>

          <div class="buttons">
            <% lang = @page.lang %>
            <% lang = 'en-gb' if lang == 'en' %> 
            <% if @page.pageable['booking_slug'] && !@page.pageable['booking_slug'].blank? %>
               <a href="https://www.kqzyfj.com/click-<%= settings.booking_com_pid %>-<%= settings.booking_com_link_id %>?url=https%3A%2F%2Fwww.booking.com%2Fhotel%2Fsi%2F<%= @page_details['booking_slug'] %>.<%= lang %>.html&sid=<%= @page.url %>" class="button is-big is-success"><%= label_by_lang('_сheck_availability') %></a>
            <% else %>
              
              <% if @page.uri.start_with?(/\A\/[a-zA-Z]{2}\//) %>
                <% town = @page.uri.split('/')[2] %>
              <% else %>
                <% town = @page.uri.split('/')[1] %>
              <% end %>

               <a href="https://www.kqzyfj.com/click-<%= settings.booking_com_pid %>-<%= settings.booking_com_link_id %>?url=https%3A%2F%2Fwww.booking.com%2Fsearchresults.sl.html%3Fss%3D<%= town %>&sid=<%= @page.uri %>" class="button is-big is-info"><%= label_by_lang('_сheck_availability') %></a>
            <% end %>
          </div>

          <div class="buttons mt-5">
            <%= @page.hero_3 %>

            <%= link_on_page('_gallery') %>
            <%= link_on_page('_what_is_near') %>
            <%= link_on_page('_faq') %>
            
           </div>

           <%= partial('_share_buttons') %>

        </div>

        <div class="column is-7">
          <%= partial '_picture_pageable' %>
        </div>

      </div>
    </div>
  </div>
</section>

<% end %> 

