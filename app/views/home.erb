<% content_for :breadcrumb do %>
  <ul>
    <li class='is-active'><a href='/' title="<%= settings.href_titles[:home] %>">Home</a></li>
  </ul>
<% end %>

<% content_for :hero do %>
	<section class="hero is-info">
	<div class="hero-body">
	 <div class="container">
	   <h1 class="title is-size-1">
	     Yoga Classes Near Me
	   </h1>
	   <h2 class="subtitle">

	     <%= Item.listed.size %> yoga classes, in <%= @pps.size %> cities and <%= @countries.size %> countries 

	   </h2>
	 </div>
	</div>
	</section>
<% end %>

<% content_for :sidebar do %>
  <!--<button class="button is-success">Add your classes</button>
  <p class="is-size-7">it's free-->
<% end %>


<div class="content mt-6">

  <h2 class="title is-size-3 mt-4 mb-5">Just Added</h2>
  <%= paginate(@items) %><%= erb :'/partials/_items', :locals => {:items => @items} if @items %>


  <h2 class="title is-size-3 mt-6 mb-5">Yoga Classes in <%= @home_country.name %> </h2>

  <div class="field is-grouped is-grouped-multiline"> 
  <% @home_country.children.each do |adm1| %>

    <% if adm1&.items_of_adm1&.listed&.size&.>(0) %>
      <div class="control">
        <div class="tags has-addons">
          <span class="tag">
            <a href="/<%= adm1.permalink -%>" title='Yoga studios and classes in <%= adm1.name %>'><%= adm1.name_short %></a>
          </span> 
          <span class="tag is-primary">
            <%= adm1.items_of_adm1.listed.size -%> 
          </span>
        </div>
      </div>
    <% end %>

  <% end %>
  </div>





  <h2 class="title is-size-3 mt-6 mb-6">All Yoga listings by continent</h2>
	<% CONTINETS_COUNTRIES.each do |continent, country_codes| %>
	  <h3 class="title is-size-4 mt-4 mb-4"><%= continent %></h3>
	 
		<div class="field is-grouped is-grouped-multiline">
		  <% country_codes.each do |country_code| %>
      	<% country = @countries.where(country_code: country_code).first %>
      	<% if country&.items_of_country&.listed&.size&.>(0) %>
          <div class="control">
            <div class="tags has-addons">
              <span class="tag">
                  <a href="/<%= country.permalink -%>" title='Yoga studios and classes in <%= country.name %>'><%= country.name_short %></a>
              </span> 
              <span class="tag is-primary">
                <%= country.items_of_country.listed.size -%> 
              </span>
            </div>
          </div>
        <% end %>
  	  <%- end -%>
		</div>  
	<% end %>	
  
</div>