<% content_for :hero_3 do %>
  <div class="buttons">
    <%= link_on_page('_regions') %>
    <%= link_on_page('_options') %>
    <%#= link_on_page('_gallery') unless @page.pageable.pictures.size == 0 %>
    <%= link_on_page('_faq') unless @page.faq.blank? %>
