<% content_for :sidebar do %>
<% end %> <!-- end of content_for :sidebar -->

<%= parse_erb_and_markdown @page.body if @page.body %>

<% if @page.block_1.blank? %>
  <%= partial '_list_paginated' %>
<% else %>
  <%= parse_erb_and_markdown @page.block_1 if @page.block_5 %>
<% end %>

<%#= partial '_map_stay22' %>

<% if @page.block_5.blank? %>
  <h2 class="title has-text-weight-medium" id="_regions"><%= @page.h1 %> by Region</h2>
  <%= partial '_geo_sibling_links', child_group: 'addressRegion', anchor: 'anchor_1' %>
<% else %>
  <%= parse_erb_and_markdown @page.block_5 if @page.block_5 %>
<% end %>
  
<% if @page.block_6.blank? %>
  <h2 class="title has-text-weight-medium mt-6" id="_options">more options in <%= @page.anchor_1 %></h2>

  <% Tag.where(parent_id: [nil, 0]).where.not(name: ['addressCountry', 'addressRegion', 'addressLocality', 'adm_2']).each do |t_g| %>
    <% 
      group_html = partial '_page_children_links_by_group', group: t_g.name, anchor: 'anchor_1'
    %>
    <% unless group_html.blank? %>
      <h3 class="title is-size-5  is-family-monospace"><%= t_g.short %></h3>
      <%= group_html %>
    <% end %>

  <% end %>

<% else %>
  <%= parse_erb_and_markdown @page.block_6 if @page.block_6 %>
<% end %>

