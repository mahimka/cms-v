<div class="columns">

  <div class="column is-2">
    <%= label(:profile, :site_id, "site", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <% @sites_for_select = {"": ""}.merge(Site.order(:name).to_h { |site| [site.id, site.name.presence || site.domain] }) %>
    <%= select(:profile, :site_id, @sites_for_select, options = {class: 'select input is-success', value: @profile.site_id}) %>
    <p class="help">нет нужного сайта? <a href="/admin/sites/new" target="_blank">создать</a></p>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:profile, :profileable_type, "profileable", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <input type="hidden" name="profile[profileable_type]" value="<%= @profile.profileable_type %>">
    <input type="hidden" name="profile[profileable_id]" value="<%= @profile.profileable_id %>">
    <p class="input is-static">
      <%= @profile.profileable_type %> #<%= @profile.profileable_id %>
      <% if @profile.profileable %>
        — <a href="/admin/<%= @profile.profileable.class.name.underscore.pluralize %>/<%= @profile.profileable.id %>/edit" target="_blank"><%= @profile.profileable.name %></a>
      <% end %>
    </p>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:profile, :url, "url", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:profile, :url, options = {class: 'input is-success', value: @profile.url, placeholder: "https://..."}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:profile, :notes, "notes", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= textarea(:profile, :notes, content = "#{@profile.notes}", options = {class: 'textarea is-success', rows: 3}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:profile, :status, "status", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:profile, :status, options = {class: 'input is-success', value: @profile.status, placeholder: "enter status"}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:profile, :redirected_to, "redirected_to", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:profile, :redirected_to, options = {class: 'input is-success', value: @profile.redirected_to, placeholder: "https://..."}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:profile, :active, "active", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <input type="hidden" name="profile[active]" value="0">
    <input type="checkbox" name="profile[active]" value="1" <%= @profile.active ? "checked" : "" %>>
  </div>

</div>
