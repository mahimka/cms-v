<script>
  $(document).ready(function(){
   $( "#page_kind" ).change(function() {
    
    var selected = "";
    $( "#page_kind option:selected" ).each(function() {
      selected += $( this ).text();
      //alert(selected);
    });

    if (selected == "pageable"){
      //alert(selected);

      $( "#pageable_fields" ). removeClass( 'is-hidden');
      $( "#list_fields" ).     addClass( 'is-hidden');
      $( "#list_fields_2" ).   addClass( 'is-hidden');

      // очищаю поля (reset здесь не то, он сбрасывает до исходных!)
      $("#page_list_item").val(1);
      $("#page_list_tags").val('');
      $("#page_list_tags_option").val(1);
      $("#page_list_page_template_id").val(1);
      $("#page_list_pagination").val(1);
      $("#page_list_partial").val(1);
      $("#page_list_order").val(1);
      $("#page_list_per_page").val();
    
    }
    else if (selected == "list"){
      //alert(selected);
      $( "#list_fields" ).     removeClass ( 'is-hidden');
      $( "#list_fields_2" ).   removeClass ( 'is-hidden');
      $( "#pageable_fields" ). addClass( 'is-hidden');

      // очищаю поля (reset здесь не то, он сбрасывает до исходных!)
      $("#page_pageable_type").val(1);
      $("#page_pageable_id").val('');
      
    } else {
      $( "#pageable_fields" ). addClass( 'is-hidden');
      $( "#list_fields" ).     addClass ( 'is-hidden');
      $( "#list_fields_2" ).   addClass ( 'is-hidden');
    }
     //$( "#template_kind_fields" ).text( str );
  })
  .trigger( "change" );

});
</script>

