<% content_for :header_js do %>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<% end %>

<%#= input(:q, :name_cont, options = {class: 'input is-small', value: @q.name_cont, placeholder: "enter name"}) %>

<form method="GET" action="/admin/profiles">

<div class="columns mb-0 ">
  <div class="column is-1">
    <p class="help is-size-7 has-text-weight-bold mt-0">url_cont</p>
    <%= input(:q, :url_cont, options = {class: 'input is-small', value: @q.url_cont, placeholder: ""}) %>
  </div>
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">profileable_type_cont</p>
    <%= input(:q, :profileable_type_cont, options = {class: 'input is-small', value: @q.profileable_type_cont, placeholder: ""}) %>
  </div>
  <div class="column is-1">
    <p class="help is-size-7 has-text-weight-bold mt-0">notes_cont</p>
    <%= input(:q, :notes_cont, options = {class: 'input is-small', value: @q.notes_cont, placeholder: ""}) %>
  </div>
  <div class="column is-1">
    <p class="help is-size-7 has-text-weight-bold mt-0">status_cont</p>
    <%= input(:q, :status_cont, options = {class: 'input is-small', value: @q.status_cont, placeholder: ""}) %>
  </div>

  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">title_cont</p>
    <%= input(:q, :title_cont, options = {class: 'input is-small', value: @q.title_cont, placeholder: ""}) %>
  </div>
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">h1_cont</p>
    <%= input(:q, :h1_cont, options = {class: 'input is-small', value: @q.h1_cont, placeholder: ""}) %>
  </div>
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">meta_description_cont</p>
    <%= input(:q, :meta_description_cont, options = {class: 'input is-small', value: @q.meta_description_cont, placeholder: ""}) %>
  </div>

</div>

<div class="columns is-mobile is-variable is-1 mb-0 is-size-7">

    <div class="column is-1">
      <b>blank: </b>
    </div>

    <div class="column is-1">
      <input type="checkbox" name="q[title_blank]" value='1'  <%= @q.title_blank  ? "checked" : "" %>>
      title
    </div>
    <div class="column is-1">
      <input type="checkbox" name="q[h1_blank]" value='1'  <%= @q.h1_blank  ? "checked" : "" %>>
      h1
    </div>
    <div class="column is-2">
      <input type="checkbox" name="q[meta_description_blank]" value='1'  <%= @q.meta_description_blank  ? "checked" : "" %>>
      meta_description
    </div>

</div>

<div class="columns is-mobile is-variable is-1 mb-0 is-size-7">

    <div class="column is-1">
      <b>not_blank: </b>
    </div>

    <div class="column is-1">
      <input type="checkbox" name="q[title_present]" value='1'  <%= @q.title_present  ? "checked" : "" %>>
      title
    </div>
    <div class="column is-1">
      <input type="checkbox" name="q[h1_present]" value='1'  <%= @q.h1_present  ? "checked" : "" %>>
      h1
    </div>
    <div class="column is-2">
      <input type="checkbox" name="q[meta_description_present]" value='1'  <%= @q.meta_description_present  ? "checked" : "" %>>
      meta_description
    </div>

</div>

