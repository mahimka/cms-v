</form>


<div class="content is-size-7">
  <%= paginate(@profiles) %>
</div> 

<div class="content">

  <table class="table is-size-7">
    <tr>
      <td></td>
      <td>url</td>
      <td>p_type</td>
      <td>p_id</td>
      <td>status</td>
      <td>scraped_at</td>
      <td>title</td>
      <td>h1</td>
      <td>meta_description</td>
      <td></td>

    </tr>

  <% @profiles.each do |profile| %>

    <tr>
      <td><%= checkbox_in_place profile, :active %></td>
      <td><%= profile.url %></td>
      <td><%= profile.profileable_type %></td>
      <td><%= profile.profileable_id %></td>
      <td><%= profile.status %></td>
      <td><%= profile.scraped_at %></td>
      <td><%#= input_in_place profile, :title %><%= profile.title %></td>
      <td><%#= input_in_place profile, :h1 %><%= profile.h1 %></td>
      <td><%#= input_in_place profile, :meta_description %><%= profile.meta_description&.length %></td>

      <td><a href="/admin/profiles/<%= profile.id %>/edit" class='button is-small'>edit</a></td>


    </tr>
  
  <% end %>

  </table>  

</div>

</div>

