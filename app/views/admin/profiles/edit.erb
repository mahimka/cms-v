<%= erb :'/layout/_flash', views: settings.views %>

<div class="content m-3">

  <h1 class="title">Profile #<%= @profile.id %></h1>

  <form method="POST" action="/admin/profiles/<%= @profile.id %>">
    <input type="hidden" name="_method" value="PATCH">

    <%= erb :'/profiles/_form', views: settings.views_admin %>

    <div class="field is-grouped">
      <div class="control">
        <input type="submit" value="Update Profile" class="button is-link is-warning">
      </div>
      <div class="control">
        <a href="/admin/profiles/<%= @profile.id %>" class="button">Show</a>
      </div>
    </div>

  </form>

</div>
