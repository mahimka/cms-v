<%= erb :'/layout/_flash', views: settings.views_admin %>

<div class="content m-3">

  <h1 class="title">New item</h1>
  <p class="subtitle is-6">Step 1: name and schema. Details, tags and links can be filled in on the next step.</p>

  <form method="POST" action="/admin/items">

    <div class="columns">

      <div class="column is-2">
        <%= label(:item, :name, "name", options = {class: 'label'}) %>
      </div>

      <div class="column is-9">
        <%= input(:item, :name, options = {class: 'input is-success', value: @item.name, placeholder: "enter item name"}) %>
      </div>

    </div>

    <div class="columns">

      <div class="column is-2">
        <%= label(:item, :schema_id, "schema", options = {class: 'label'}) %>
      </div>

      <div class="column is-9">
        <% @schemas_for_select = {"": ""}.merge(Schema.active.order(:ancestry, :position, :name).to_h { |schema| [schema.id, ("— " * schema.depth) + schema.name] }) %>
        <%= select(:item, :schema_id, @schemas_for_select, options = {class: 'select input is-success', value: @item.schema_id, required: true}) %>
      </div>

    </div>

    <div class="field is-grouped">
      <div class="control">
        <input type="submit" value="Create Item" class="button is-warning">
      </div>
    </div>

  </form>

</div>
