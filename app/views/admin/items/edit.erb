<%= erb :'/layout/_flash', views: settings.views %>

<div class="content m-3">

  <h1 class="title"><%= @item.name %></h1>
  <p class="subtitle is-6">Step 2: остальные поля, details, tags, links и pictures.</p>

  <form method="POST" action="/admin/items/<%= @item.id %>">
    <input type="hidden" name="_method" value="PATCH">

    <%= erb :'/items/_form', views: settings.views_admin %>

    <%= erb :'/items/_tags_fields', views: settings.views_admin %>

    <div class="field is-grouped">
      <div class="control">
        <input type="submit" value="Update Item" class="button is-link is-warning">
      </div>
      <div class="control">
        <a href="/admin/items/<%= @item.id %>" class="button">Show</a>
      </div>
    </div>

  </form>

  <%# отдельно от формы Item: у каждой детали/ссылки/картинки свой
      ресурс/маршрут и своя <form> на строку — вложенные <form> в HTML
      невалидны, браузер обрывает внешнюю форму на первой же вложенной
      (тогда всё после неё, включая кнопку Update Item, вылетает из
      формы и submit вообще ничего не отправляет). %>
  <%= erb :'/items/_details_fields', views: settings.views_admin %>

  <%= erb :'/items/_links_fields', views: settings.views_admin %>

  <%= erb :'/items/_profiles_fields', views: settings.views_admin %>

  <%= erb :'/items/_pictures_fields', views: settings.views_admin %>

</div>
