<div class="columns">

  <div class="column is-2">
    <%= label(:item, :name, "name", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:item, :name, options = {class: 'input is-success', value: @item.name, placeholder: "enter item name"}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:item, :schema_id, "schema", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <% @schemas_for_select = {"": ""}.merge(Schema.active.order(:ancestry, :position, :name).to_h { |schema| [schema.id, ("— " * schema.depth) + schema.name] }) %>
    <%= select(:item, :schema_id, @schemas_for_select, options = {class: 'select input is-success', value: @item.schema_id}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:item, :ean, "ean", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:item, :ean, options = {class: 'input is-success', value: @item.ean, placeholder: "enter ean"}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:item, :generate_pages, "generate_pages", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <input type="hidden" name="item[generate_pages]" value="0">
    <input type="checkbox" name="item[generate_pages]" value="1" <%= @item.generate_pages ? "checked" : "" %>>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:item, :is_closed, "is_closed", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <input type="hidden" name="item[is_closed]" value="0">
    <input type="checkbox" name="item[is_closed]" value="1" <%= @item.is_closed ? "checked" : "" %>>
  </div>

</div>
