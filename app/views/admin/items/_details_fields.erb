<div class="columns">

  <div class="column is-2">
    <p class="label">details</p>
    <% if @item.schema %>
      <p class="help">ключи из schema «<%= @item.schema.name %>» (с учётом родительских схем)</p>
    <% else %>
      <p class="help">у item не задана schema — показаны только уже сохранённые параметры</p>
    <% end %>
  </div>

  <div class="column is-9">

    <% effective_labels = @item.effective_labels.order(:position, :name) %>
    <% used_label_ids = @item.detail_records.map(&:label_id) %>

    <% @item.detail_records.includes(:label).order("labels.position, labels.name").each do |detail| %>
      <div class="columns is-mobile mb-1">

        <form method="POST" action="/admin/details/<%= detail.id %>" class="column is-11 field has-addons mb-0">
          <input type="hidden" name="_method" value="PATCH">
          <input type="hidden" name="redirect_to" value="/admin/items/<%= @item.id %>/edit">
          <div class="control">
            <%= select(:detail, :label_id, effective_labels.to_h { |l| [l.id, l.name] }, options = {class: 'select input is-small', value: detail.label_id}) %>
          </div>
          <div class="control is-expanded">
            <input type="text" class="input is-small" name="detail[value]" value="<%= fast_escape_html(detail.value) %>" placeholder="значение">
          </div>
          <div class="control">
            <button type="submit" class="button is-small is-info">save</button>
          </div>
        </form>

        <form method="POST" action="/admin/details/<%= detail.id %>" class="column is-1" onsubmit="return confirm('Delete this detail?')">
          <input type="hidden" name="_method" value="DELETE">
          <input type="hidden" name="redirect_to" value="/admin/items/<%= @item.id %>/edit">
          <button type="submit" class="button is-small is-danger">&times;</button>
        </form>

      </div>
    <% end %>

    <hr class="my-2">

    <% available_labels = effective_labels.reject { |l| used_label_ids.include?(l.id) } %>

    <% if available_labels.any? %>
      <form method="POST" action="/admin/details" class="field has-addons">
        <input type="hidden" name="detail[detailable_type]" value="Item">
        <input type="hidden" name="detail[detailable_id]" value="<%= @item.id %>">
        <input type="hidden" name="redirect_to" value="/admin/items/<%= @item.id %>/edit">
        <div class="control">
          <%= select(:detail, :label_id, available_labels.to_h { |l| [l.id, l.name] }, options = {class: 'select input is-small'}) %>
        </div>
        <div class="control is-expanded">
          <input type="text" class="input is-small" name="detail[value]" placeholder="значение">
        </div>
        <div class="control">
          <button type="submit" class="button is-small is-success">+ add detail</button>
        </div>
      </form>
    <% else %>
      <p class="help">все ключи из schema уже заполнены — новые можно завести в разделе <a href="/admin/labels">Labels</a></p>
    <% end %>

    <p class="help">параметр выбирается только из ключей, привязанных к schema — новый ключ сначала нужно завести в <a href="/admin/labels">Labels</a></p>

  </div>

</div>
