<form method="GET" action="/admin/histories">

<div class="columns mb-0 ">
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">old_uri_cont</p>
    <%= input(:q, :old_uri_cont, options = {class: 'input is-small', value: @q.old_uri_cont, placeholder: ""}) %>
  </div>
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">new_uri_cont</p>
    <%= input(:q, :new_uri_cont, options = {class: 'input is-small', value: @q.new_uri_cont, placeholder: ""}) %>
  </div>
  <div class="column is-1">
    <p class="help is-size-7 has-text-weight-bold mt-0">redirect_code_eq</p>
    <%= input(:q, :redirect_code_eq, options = {class: 'input is-small', value: @q.redirect_code_eq, placeholder: ""}) %>
  </div>
  <div class="column is-1">
    <p class="help is-size-7 has-text-weight-bold mt-0">page_id_eq</p>
    <%= input(:q, :page_id_eq, options = {class: 'input is-small', value: @q.page_id_eq, placeholder: ""}) %>
  </div>
</div>

<hr class="my-2">

<div class="columns is-mobile is-variable is-1 mb-0 is-size-7">
  <div class="column is-1">
    <input type="submit" value="Filter" class="button is-warning">
  </div>

  <div class="column is-3">
    <h6 class="title is-size-6 mt-2">Found/Total: <%= @histories_found.size %> / <%= History.all.size %></h6>
  </div>
</div>

<hr class="my-0">

</form>

<div class="content is-size-7">
  <%= paginate(@histories) %>
</div>

<div class="content">

  <table class="table is-size-7">
    <tr>
      <td>old_uri</td>
      <td>new_uri</td>
      <td>code</td>
      <td>page</td>
      <td>created_at</td>
    </tr>

  <% @histories.each do |history| %>

    <tr>
      <td><%= history.old_uri %></td>
      <td><%= history.new_uri %></td>
      <td><%= history.redirect_code %></td>
      <td>
        <% if history.page %>
          <a href="/admin/pages/<%= history.page_id %>/edit-in-place">
            <%= history.page.uri %>
          </a>
        <% else %>
          &mdash;
        <% end %>
      </td>
      <td><%= history.created_at %></td>
    </tr>

  <% end %>

  </table>

</div>
