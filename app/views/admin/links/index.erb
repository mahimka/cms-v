<p><a class="button is-warning" href="/admin/links/new">Add Link</a></p>

<div class="content m-3">

  <div class="box">
    <p class="has-text-weight-semibold mb-2">статус проверки ссылок</p>
    <div class="columns is-mobile is-size-7">
      <div class="column">всего<br><span class="is-size-5"><%= @checked_stats[:total] %></span></div>
      <div class="column">проверено<br><span class="is-size-5"><%= @checked_stats[:checked] %></span></div>
      <div class="column">не проверено<br><span class="is-size-5"><%= @checked_stats[:unchecked] %></span></div>
      <div class="column has-text-success">active<br><span class="is-size-5"><%= @checked_stats[:active] %></span></div>
      <div class="column has-text-danger">inactive<br><span class="is-size-5"><%= @checked_stats[:inactive] %></span></div>
      <div class="column">redirected<br><span class="is-size-5"><%= @checked_stats[:redirected] %></span></div>
      <div class="column">старше 15 дней / не проверено<br><span class="is-size-5"><%= @checked_stats[:stale] %></span></div>
    </div>

    <table class="table is-narrow is-size-7 mt-2">
      <tr class="has-text-weight-semibold"><td>label</td><td>всего</td><td>проверено</td><td>inactive</td></tr>
      <% @checked_by_label.each do |row| %>
        <tr>
          <td><%= row.label_name %></td>
          <td><%= row.total %></td>
          <td><%= row.checked %></td>
          <td><%= row.inactive %></td>
        </tr>
      <% end %>
    </table>
  </div>

<form method="GET" action="/admin/links">

  <div class="columns">
    <div class="column is-2">
      <tag class="tag is-size-7">linkable_type_eq</tag>
      <% @linkable_types_for_select = {"": ""}.merge(LinksController::LINKABLE_TYPES.to_h { |type| [type, type] }) %>
      <%= select(:q, :linkable_type_eq, @linkable_types_for_select, options = {class: 'select input is-small', value: @q.linkable_type_eq}) %>
    </div>
    <div class="column is-2">
      <tag class="tag is-size-7">url_cont</tag>
      <%= input(:q, :url_cont, options = {class: 'input is-small', value: @q.url_cont, placeholder: ""}) %>
    </div>
    <div class="column is-2">
      <tag class="tag is-size-7">label_name_cont</tag>
      <%= input(:q, :label_name_cont, options = {class: 'input is-small', value: @q.label_name_cont, placeholder: ""}) %>
    </div>
    <div class="column is-2">
      <tag class="tag is-size-7">response_cont</tag>
      <%= input(:q, :response_cont, options = {class: 'input is-small', value: @q.response_cont, placeholder: ""}) %>
    </div>
    <div class="column is-1">
      <input type="checkbox" name="q[active_true]" value='1' <%= @q.active_true ? "checked" : "" %>>
      active: true
    </div>
    <div class="column is-1">
      <input type="checkbox" name="q[active_false]" value='1' <%= @q.active_false ? "checked" : "" %>>
      active: false
    </div>
    <div class="column is-1">
      <input type="checkbox" name="q[redirected_true]" value='1' <%= @q.redirected_true ? "checked" : "" %>>
      redirected: true
    </div>
  </div>

  <div class="columns">
    <div class="column is-1">
      <input type="submit" value="Filter" class="button is-warning">
    </div>
    <div class="column is-11">
      Found/Total: <%= @links_found %> / <%= Link.all.size %>
    </div>
  </div>

</form>

<div class="content">

  <div class="columns is-mobile is-variable is-1 mt-0 mb-0">
    <div class="column is-12">
      <%= paginate @links unless @links.blank? %>
    </div>
  </div>

  <table class="table is-narrow is-size-7">
    <tr class="is-size-6 has-text-weight-semibold">
      <td>active</td>
      <td>linkable</td>
      <td>label</td>
      <td>url</td>
      <td>ready</td>
      <td>published</td>
      <td>checked_at</td>
      <td>response</td>
      <td></td>
    </tr>

  <% @links.each do |link| %>

    <tr>
      <td><%= checkbox_in_place(link, :active) %></td>
      <td>
        <% if link.linkable %>
          <a href="/admin/<%= link.linkable.class.name.underscore.pluralize %>/<%= link.linkable.id %>">
            <%= link.linkable_type %> #<%= link.linkable_id %>
          </a>
        <% else %>
          <%= link.linkable_type %> #<%= link.linkable_id %>
        <% end %>
      </td>
      <td><%= link.label&.name %></td>
      <td><a href="<%= link.url %>" target="_blank"><%= link.url %></a></td>
      <td><%= link.ready %></td>
      <td><%= link.published %></td>
      <td><%= link.checked_at&.strftime("%d %b %Y %H:%M") %></td>
      <td>
        <%= link.response %>
        <% if link.redirected? && link.redirected_to.present? %>
          → <a href="<%= link.redirected_to %>" target="_blank"><%= link.redirected_to %></a>
        <% end %>
      </td>
      <td>
        <a href="/admin/links/<%= link.id %>" class="button is-small">show</a>
        <a href="/admin/links/<%= link.id %>/edit" class="button is-small">edit</a>
        <form method="POST" action="/admin/links/<%= link.id %>/check" style="display:inline">
          <input type="hidden" name="redirect_to" value="/admin/links">
          <button type="submit" class="button is-small is-link">check</button>
        </form>
      </td>
    </tr>

  <% end %>

  </table>

</div>

</div>
