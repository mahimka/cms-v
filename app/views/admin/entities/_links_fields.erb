<div class="columns">

  <div class="column is-2">
    <p class="label">links</p>
    <p class="help">вебадреса (сайт, соцсети и т.п.), каждая привязана к label</p>
  </div>

  <div class="column is-9">

    <% labels_for_select = {"": ""}.merge(Label.active.order(:ancestry, :position, :name).to_h { |l| [l.id, ("" * l.depth) + l.name] }) %>

    <% if settings.respond_to?(:link_labels_id) && settings.link_labels_id %>

      <% labels_for_select = Label.find(settings.link_labels_id).children.active.order(:ancestry, :position, :name).to_h { |l| [l.id, ("" * l.depth) + l.name] } %>
    <% else %>
      <% labels_for_select = Label.find_by_name('link_labels').children.active.order(:ancestry, :position, :name).to_h { |l| [l.id, ("" * l.depth) + l.name] } %>
    <% end %>

    <form method="POST" action="/admin/entities/<%= @entity.id %>/links/check_all" class="mb-3">
      <button type="submit" class="button is-small is-warning" title="Проверить статус всех ссылок этой entity — см. lib/link_checker.rb">⟳ проверить все ссылки</button>
    </form>

    <% @entity.links.each do |link| %>
      <div class="columns is-mobile mb-0">

        <form method="POST" action="/admin/links/<%= link.id %>" class="column is-7 field has-addons mb-0">
          <input type="hidden" name="_method" value="PATCH">
          <input type="hidden" name="redirect_to" value="/admin/entities/<%= @entity.id %>/edit">
          <div class="control">
            <%= select(:link, :label_id, labels_for_select, options = {class: 'select input is-small', value: link.label_id}) %>
          </div>
          <div class="control is-expanded">
            <input type="text" class="input is-small" name="link[url]" value="<%= fast_escape_html(link.url) %>" placeholder="https://...">
          </div>
          <div class="control">
            <button type="submit" class="button is-small is-info">save</button>
          </div>

        </form>

        <form method="POST" action="/admin/links/<%= link.id %>/check" class="column is-2">
          <input type="hidden" name="redirect_to" value="/admin/entities/<%= @entity.id %>/edit">
          <button type="submit" class="button is-small is-link" title="Проверить статус этой ссылки сейчас">check</button>
        </form>

          <div class="column is-2">
            <a href="<%= link.url %>" target="_blank" class="button is-small is-success">go</a>
          </div>

        <form method="POST" action="/admin/links/<%= link.id %>" class="column is-1" onsubmit="return confirm('Delete this link?')">
          <input type="hidden" name="_method" value="DELETE">
          <input type="hidden" name="redirect_to" value="/admin/entities/<%= @entity.id %>/edit">
          <button type="submit" class="button is-small is-danger">&times;</button>
        </form>

      </div>
      <div class="columns is-mobile my-0 py-0 mb-2">
        <div class="column is-11 py-0 is-size-7 has-text-grey">
          <% if link.checked_at %>
            checked <%= link.checked_at.strftime("%d %b %Y %H:%M") %> — <%= link.response %>
            <% if link.redirected? && link.redirected_to.present? %>
              → redirect: <a href="<%= link.redirected_to %>" target="_blank"><%= link.redirected_to %></a>
            <% end %>
          <% else %>
            не проверялась
          <% end %>
        </div>
      </div>
    <% end %>

    <hr class="my-2">

    <form method="POST" action="/admin/links" class="field has-addons">
      <input type="hidden" name="link[linkable_type]" value="Entity">
      <input type="hidden" name="link[linkable_id]" value="<%= @entity.id %>">
      <input type="hidden" name="redirect_to" value="/admin/entities/<%= @entity.id %>/edit">
      <div class="control">
        <%= select(:link, :label_id, labels_for_select, options = {class: 'select input is-small'}) %>
      </div>
      <div class="control is-expanded">
        <input type="text" class="input is-small" name="link[url]" placeholder="https://...">
      </div>
      <div class="control">
        <button type="submit" class="button is-small is-success">+ add link</button>
      </div>
    </form>

  </div>

</div>



