<div class="columns">

  <div class="column is-2">
    <p class="label">tags</p>
    <% if @entity.schema %>
      <p class="help">теги из schema «<%= @entity.schema.name %>» (с учётом родительских схем)</p>
    <% else %>
      <p class="help">у entity не задана schema — нечего предложить</p>
    <% end %>
  </div>

  <div class="column is-9">

    <% schema_tags   = @entity.effective_tags.to_a %>
    <% selected_ids   = @entity.tag_ids %>
    <%# Уже прикреплённые теги всегда показываем чекбоксом, даже если они
        вне текущей schema (например после смены schema у entity) — иначе
        такой тег невозможно снять: чекбокса для него просто нет в форме. %>
    <% attached_out_of_scope = @entity.tags.where.not(id: schema_tags.map(&:id)) %>
    <% grouped_tags   = (schema_tags + attached_out_of_scope).group_by { |tag| tag.parent } %>

    <% grouped_tags.each do |parent, children| %>
      <p class="has-text-weight-semibold is-size-7 mt-2"><%= parent&.name || "—" %></p>
      <% children.each do |tag| %>
        <label class="checkbox mr-3">
          <input type="checkbox" name="tag_ids[]" value="<%= tag.id %>" <%= "checked" if selected_ids.include?(tag.id) %>>
          <%= tag.name %>
        </label>
      <% end %>
    <% end %>

  </div>

</div>
