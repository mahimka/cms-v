<%= erb :'/layout/_flash', views: settings.views_admin %>

<form method="GET" action="/admin/entities">

<div class="columns mb-0 ">

  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">tag_name_cont</p>
    <input class="input is-small" type="text" name="q[tags_name_cont]" value="<%= @q.tags_name_cont %>" placeholder="enter name">
  </div>

  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">name_cont</p>
    <input class="input is-small" type="text" name="q[name_cont]" value="<%= @q.name_cont %>" placeholder="enter name">
  </div>
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">schema_name_cont</p>
    <input class="input is-small" type="text" name="q[schema_name_cont]" value="<%= @q.schema_name_cont %>" placeholder="">
  </div>
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">address_cont</p>
    <input class="input is-small" type="text" name="q[address_cont]" value="<%= @q.address_cont %>" placeholder="">
  </div>
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">parent_name_cont</p>
    <input class="input is-small" type="text" name="q[parent_name_cont]" value="<%= @q.parent_name_cont %>" placeholder="">
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[active_true]" value='1'  <%= @q.active_true  ? "checked" : "" %>>
    active 
  </div>

  <div class="column is-2">
    <input type="checkbox" name="q[active_blank]" value='1'  <%= @q.active_blank  ? "checked" : "" %>>
    not active 
  </div>



</div>

<div class="columns mb-0">
  <div class="column">
    <p class="help is-size-7 has-text-weight-bold mt-0">
      tags (все выбранные одновременно):
      <span id="selected-tags-list" class="tags are-small ml-1" style="display:inline-flex; vertical-align:middle;"></span>
    </p>

    <% grouped_tags = Tag.active.includes(:parent).order(:name).group_by(&:parent) %>

    <div style="display:flex; flex-wrap:wrap; gap: 0.25rem 1.25rem;">
      <% grouped_tags.each do |parent, children| %>
        <% group_has_selected = children.any? { |tag| @filter_tag_names.include?(tag.name) } %>
        <details style="flex: 0 0 auto;" <%= "open" if group_has_selected %>>
          <summary class="has-text-weight-semibold is-size-7" style="cursor:pointer;"><%= parent&.name || "—" %></summary>
          <div class="pl-4 pt-1">
            <% children.each do |tag| %>
              <label class="checkbox mr-3 is-size-7 tag-filter-checkbox">
                <input type="checkbox" name="tag_names[]" value="<%= tag.name %>" <%= "checked" if @filter_tag_names.include?(tag.name) %>>
                <%= tag.name %>
              </label>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function () {
    function renderSelectedTags() {
      var $list = $('#selected-tags-list');
      $list.empty();

      $('.tag-filter-checkbox input:checked').each(function () {
        var $checkbox = $(this);
        var $chip = $('<span class="tag is-info"></span>').text($checkbox.val());
        var $remove = $('<a class="delete is-small ml-1"></a>');

        $remove.on('click', function (e) {
          e.preventDefault();
          $checkbox.prop('checked', false);
          renderSelectedTags();
        });

        $chip.append($remove);
        $list.append($chip);
      });
    }

    $(function () {
      renderSelectedTags();
      $('.tag-filter-checkbox input').on('change', renderSelectedTags);
    });
  })();
</script>

<div class="columns is-mobile is-variable is-1 mb-0 is-size-7">
  <div class="column is-1">
    <b>present: </b>
  </div>
  <div class="column is-1">
    <input type="checkbox" name="q[with_page]" value='1' <%= params.dig(:q, :with_page) == '1' ? "checked" : "" %>>
    page
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[schema_id_not_null]" value='1' <%= @q.schema_id_not_null ? "checked" : "" %>>
    schema
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[address_present]" value='1' <%= @q.address_present ? "checked" : "" %>>
    address
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[parent_id_not_null]" value='1' <%= @q.parent_id_not_null ? "checked" : "" %>>
    parent_id
  </div>
  <div class="column is-1">
    <input type="checkbox" name="q[detail_records_id_not_null]" value='1' <%= @q.detail_records_id_not_null ? "checked" : "" %>>
    details
  </div>
  <div class="column is-1">
    <input type="checkbox" name="q[tags_name_present]" value='1' <%= @q.tags_name_present ? "checked" : "" %>>
    tags
  </div>
  <div class="column is-1">
    <input type="checkbox" name="q[links_url_present]" value='1' <%= @q.links_url_present ? "checked" : "" %>>
    links
  </div>
  <div class="column is-1">
    <input type="checkbox" name="q[profiles_url_present]" value='1' <%= @q.profiles_url_present ? "checked" : "" %>>
    profiles
  </div>
  <div class="column is-1">
    <input type="checkbox" name="q[pictures_file_present]" value='1' <%= @q.pictures_file_present ? "checked" : "" %>>
    pictures
  </div>

</div>

<div class="columns is-mobile is-variable is-1 mb-0 is-size-7">

  <div class="column is-1">
    <b>not present:</b>
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[without_page]" value='1' <%= params.dig(:q, :without_page) == '1' ? "checked" : "" %>>
    pages
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[schema_id_blank]" value='1' <%= @q.schema_id_blank ? "checked" : "" %>>
    schema
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[address_blank]" value='1' <%= @q.address_blank ? "checked" : "" %>>
    address
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[parent_id_blank]" value='1' <%= @q.parent_id_blank ? "checked" : "" %>>
    parent_id
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[detail_records_id_null]" value='1' <%= @q.detail_records_id_null ? "checked" : "" %>>
    details
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[tags_name_blank]" value='1' <%= @q.tags_name_blank ? "checked" : "" %>>
    tags
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[links_url_blank]" value='1' <%= @q.links_url_blank ? "checked" : "" %>>
    links
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[profiles_url_blank]" value='1' <%= @q.profiles_url_blank ? "checked" : "" %>>
    profiles
  </div>

  <div class="column is-1">
    <input type="checkbox" name="q[pictures_file_blank]" value='1' <%= @q.pictures_file_blank ? "checked" : "" %>>
    pictures
  </div>


</div>

<hr class="my-2">

<div class="columns is-mobile is-variable is-1 mb-0 is-size-7">
  <div class="column is-1">
    <input type="submit" value="Filter" class="button is-warning">
  </div>

  <div class="column is-1">
    <a href="/admin/entities/new" class="button is-success">New</a>
  </div>

  <div class="column is-3">
    <h6 class="title is-size-6 mt-2">Found/Total: <%= @entities_found.size %> / <%= Entity.all.size %></h6>
  </div>
</div>

<hr class="my-0">

</form>


<div class="content is-size-7">
  <%= paginate(@entities) %>
</div>

<div class="content">

  <table class="table is-size-7">
    <tr>
      <td></td>
      <td>page</td>
      <td>web</td>
      <td>name</td>
      <td>schema</td>
      <td>address</td>
      <td>par</td>
      <td>tag</td>
      <td>det</td>
      <td>pic</td>
      <td>lnk</td>
      <td>prf</td>
      <td></td>
    </tr>

  <% @entities.each do |entity| %>

    <tr>
      <td><%= checkbox_in_place entity, :active %></td>
      <td>
        <% if entity.page %>
          <a href='/admin/pages/<%= entity.page.id %>/edit-in-place'>page</a>
        <% end %>
      </td>
      <td>
        <% if entity.page&.published? %>
          <a href='<%= entity.page.uri %>'>uri</a>
        <% elsif entity.page.present? %>
        <% else %>
          <a href='/admin/pages/new?pageable_type=Entity&pageable_id=<%= entity.id %>' class='button is-small is-warning'>+</a>
        <% end %>
      </td>
      <td width=300><%= input_in_place(entity, :name) %></td>
      <% values = Schema.active.all.map{|schema| [schema.id, schema.name]}.to_h %>
      <td width=150><%= select_in_place(entity, :schema_id, values) %></td>
      <td width=250><%= input_in_place(entity, :address) %></td>
      <td><%= entity.parent_id %></td>
      <td><%= entity&.tags&.size %></td>
      <td><%= entity&.detail_records&.size %></td>
      <td><%= entity&.pictures&.size %></td>
      <td><%= entity&.links&.size %></td>
      <td><%= entity&.profiles&.size %></td>

      <td>
        <a href="/admin/entities/<%= entity.id %>" class='button is-small'>show</a>
        <a href="/admin/entities/<%= entity.id %>/edit" class='button is-small'>edit</a>
      </td>
    </tr>

  <% end %>

  </table>

</div>
