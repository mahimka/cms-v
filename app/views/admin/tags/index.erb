<% content_for :header_js do %>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
  <script src="/javascripts/checkbox-ajax.js"></script>
<% end %>

<p>
  <a class="button is-warning" href="/admin/tags/new">Add Tag</a>
  <form method="POST" action="/admin/tags/import" enctype="multipart/form-data" style="display:inline;">
    <input type="file" name="import_file" accept="application/json" required>
    <button type="submit" class="button is-link" title="файл, выгруженный кнопкой export у группы — ищет по name, существующие обновляет, новые создаёт">Import group</button>
  </form>
</p>

<style>
  .marker-tag-picker { position: relative; display: inline-block; }
  .marker-tag-results {
    position: absolute; top: 100%; left: 0; z-index: 20;
    background: white; border: 1px solid #dbdbdb; min-width: 180px;
    max-height: 200px; overflow-y: auto;
  }
  .marker-tag-result-item { padding: 4px 8px; cursor: pointer; }
  .marker-tag-result-item:hover, .marker-tag-result-item.is-active { background: #f5f5f5; }
</style>

<div class="content m-3">

<form method="GET" action="/admin/tags">

  <div class="columns">

<!--
    <div class="column is-3">
      <tag class="tag is-size-7">site_id_eq</tag>
      <div class="control has-icons-left">
        <%# list_values = {"": ""}.merge(Site.where(rival_site: true).order("domain ASC").select(:id, :domain).to_h {|site| [site.id, site.domain]}) %>
        <%# list_values = Site.all.order("domain ASC").map{|s| "#{s.id}#{s.id.to_s.length == 6 ? '&nbsp;&nbsp;' : ' '}| #{s.name} | #{s.domain}" }.unshift("") %>
        <%#= select(:q, :site_id_eq, list_values, options = {class: 'select input is-success is-small is-family-monospace', value: @q.site_id_eq}) %>
        <span class="icon is-small is-left">
          <i class="fas fa-caret-down"></i>
        </span>
      </div>          
    </div>      
-->

    <div class="column is-2">
      <tag class="tag is-size-7">profile_profileable_name_cont</tag>
      <%#= input(:q, :profile_profileable_type_cont, options = {class: 'input is-small', value: @q.profile_profileable_type_cont, placeholder: ""}) %>
    </div>


    <div class="column is-2">
      <tag class="tag is-size-7">name_cont</tag>
      <%= input(:q, :name_cont, options = {class: 'input is-small', value: @q.name_cont, placeholder: ""}) %>
    </div>

  </div>

  <div class="columns is-mobile is-variable is-1 mb-0 is-size-7">

    <div class="column is-1">
      <b>blank: </b>
    </div>

    <div class="column is-1">
      <input type="checkbox" name="q[name_blank]" value='1'  <%= @q.name_blank  ? "checked" : "" %>>
      name_blank
    </div>
      
  </div>

  <div class="columns">
    <div class="column is-12">
      <%#= SnapShot.all.pluck(:tag).uniq %>
    </div>
  </div>

  <div class="columns">
    <div class="column is-1">
      <input type="submit" value="Filter" class="button is-warning">
    </div>
    <div class="column is-11">
      Found/Total: <%= @tags_found %> / <%= SnapShot.all.size %> |
      <%#= @tags.map{|tag| tag.response}.uniq.join(', ') %> |
      <%#= @tags.map{|tag| tag.parsed_at}.uniq.join(', ') %> 
    </div>
  </div>    

</form>

<div class="content">

  <div class="columns is-mobile is-variable is-1 mt-0 mb-0">
    <div class="column is-12">
      <%= paginate @tags unless @tags.blank? %>
    </div>
  </div>   

  <table class="table is-narrow is-size-7 ">
    <tr class="is-size-6 has-text-weight-semibold">
      <td></td>
      <td>active</td>
      <td title="запрещает менять name — на него ссылается List conditions (tags)">fixed 🔒</td>
      <td>position</td>
      <td>icon</td>
      <td>name</td>
      <td title="сколько объектов помечено этим тегом">used</td>
      <td>admin_notes</td>
      <td></td>
    </tr>

  <%# t.parent может быть nil при "осиротевшем" parent_id (родитель удалён) — тогда сам t становится своей группой, а не крашит страницу %>
  <% grouped_tags = @tags.group_by { |t| (t.parent_id.presence && t.parent_id != 0 && t.parent) ? t.parent : t } %>
  <% grouped_tags.sort_by { |group, _| [group.position || 0, group.name.to_s] }.each do |group, tags_in_group| %>

    <tr class="has-background-light is-size-7">
      <td>
        <button type="button" class="button is-small tag-group-toggle" data-group-id="<%= group.id %>" data-expanded="false">▶</button>
      </td>
      <td><%= checkbox_in_place(group, :active) %></td>
      <td><%= checkbox_in_place(group, :fixed) %></td>
      <td><%= group.position %></td>
      <td><span class="icon"><%= group.icon_svg %></span></td>
      <td class="has-text-weight-semibold"><%= group.name %></td>
      <td><%= @tagging_counts_by_tag[group.id] || 0 %></td>
      <td><%= group.admin_notes %></td>
      <td>
        <form method="POST" action="/admin/tags/<%= group.id %>/sort_children" style="display:inline;">
          <input type="hidden" name="by" value="string">
          <button type="submit" class="button is-small" title="сортировать детей группы по имени как строки">S</button>
        </form>
        <form method="POST" action="/admin/tags/<%= group.id %>/sort_children" style="display:inline;">
          <input type="hidden" name="by" value="float">
          <button type="submit" class="button is-small" title="сортировать детей группы по имени как числа (0.01, 0.5, 3, 44)">F</button>
        </form>
        <a href="/admin/tags/<%= group.id %>" class="button is-small" target='_blank'>tag</a>
        <a href="/admin/tags/<%= group.id %>/edit" class="button is-small" target='_blank'>edit</a>
        <button type="button" class="button is-small is-info is-light" data-taggable-translate-all
                data-translate-url="/admin/tags/<%= group.id %>/translate_missing_languages"
                title="Перевести name на все языки, где перевода ещё нет">✨</button>
        <form method="POST" action="/admin/tags/<%= group.id %>/export" style="display:inline;">
          <button type="submit" class="button is-small is-info" title="группа + дети, все колонки, в /<%= group.name.parameterize %>.json">export</button>
        </form>
      </td>
    </tr>

    <% (tags_in_group - [group]).sort_by { |t| [t.position || 0, t.name.to_s] }.each do |tag| %>
      <tr class="tag-group-child" data-group-id="<%= group.id %>" style="display:none;">
        <td></td>
        <td><%= checkbox_in_place(tag, :active) %></td>
        <td><%= checkbox_in_place(tag, :fixed) %></td>
        <td width=15><%= input_in_place(tag, :position) %></td>
        <td><span class="icon"><%= tag.icon_svg %></span></td>
        <td class="pl-5"><%= tag.name %></td>
        <td><%= @tagging_counts_by_tag[tag.id] || 0 %></td>
        <td><%= input_in_place(tag, :admin_notes) %></td>
        <td>
          <a href="/admin/tags/<%= tag.id %>" class="button is-small" target='_blank'>tag</a>
          <a href="/admin/tags/<%= tag.id %>/edit" class="button is-small" target='_blank'>edit</a>
          <button type="button" class="button is-small is-info is-light" data-taggable-translate-all
                  data-translate-url="/admin/tags/<%= tag.id %>/translate_missing_languages"
                  title="Перевести name на все языки, где перевода ещё нет">✨</button>
          <% unless tag.fixed? %>
            <button type="button" class="button is-small tag-merge-toggle"
                    data-tag-id="<%= tag.id %>" data-tag-name="<%= tag.name %>"
                    data-tag-count="<%= @tagging_counts_by_tag[tag.id] || 0 %>">merge</button>
            <div class="marker-tag-picker tag-merge-picker" data-tag-id="<%= tag.id %>" style="display:none;">
              <input type="text" class="input is-small tag-merge-search" placeholder="слить с..." autocomplete="off">
              <div class="marker-tag-results" style="display:none;"></div>
            </div>
          <% end %>
        </td>
      </tr>
    <% end %>

  <% end %>

  </table>

</div>

</div>

<script src="/javascripts/tag-group-toggle.js"></script>
<script src="/javascripts/tag-merge.js"></script>
<script src="/javascripts/taggable-translate.js"></script>

