<div style="max-width: 400px; margin: 40px auto; font-family: sans-serif; border: 1px solid #ccc; padding: 20px; border-radius: 8px;">
  <h2>Управление номером ZST (eTurizem)</h2>

  <% if @message %>
    <div style="color: green; margin-bottom: 15px; font-weight: bold;"><%= @message %></div>
  <% end %>
  <% if @error %>
    <div style="color: red; margin-bottom: 15px; font-weight: bold;"><%= @error %></div>
  <% end %>

  <p>Текущее значение в системе: <strong><%= @current_zst %></strong></p>

  <form action="/admin/zst" method="post" style="margin-top: 20px;">
    <div style="margin-bottom: 15px;">
      <label for="new_zst" style="display: block; margin-bottom: 5px;">Новое значение:</label>
      <input type="number" 
             id="new_zst" 
             name="new_zst" 
             value="<%= @current_zst %>" 
             min="1" 
             required 
             style="width: 100%; padding: 8px; box-sizing: border-box; font-size: 16px;">
    </div>

    <button type="submit" style="background: #28a745; color: white; border: none; padding: 10px 15px; font-size: 16px; border-radius: 4px; cursor: pointer; width: 100%;">
      Заменить номер
    </button>
  </form>
</div>