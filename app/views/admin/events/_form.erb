<div class="columns">

  <div class="column is-2">
    <%= label(:event, :name, "name", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:event, :name, options = {class: 'input is-success', value: @event.name, placeholder: "enter event name"}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:event, :schema_id, "schema", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <% @schemas_for_select = {"": ""}.merge(Schema.active.order(:ancestry, :position, :name).to_h { |schema| [schema.id, ("— " * schema.depth) + schema.name] }) %>
    <%= select(:event, :schema_id, @schemas_for_select, options = {class: 'select input is-success', value: @event.schema_id}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:event, :start_at, "start_at", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <input type="datetime-local" class="input is-success" name="event[start_at]" value="<%= @event.start_at&.strftime("%Y-%m-%dT%H:%M") %>">
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:event, :end_at, "end_at", options = {class: 'label'}) %>
    <p class="help">пусто, если событие без времени окончания</p>
  </div>

  <div class="column is-9">
    <input type="datetime-local" class="input is-success" name="event[end_at]" value="<%= @event.end_at&.strftime("%Y-%m-%dT%H:%M") %>">
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:event, :venue_id, "venue", options = {class: 'label'}) %>
    <p class="help">место проведения — Entity (отель, пляж и т.п.), если уже заведено</p>
  </div>

  <div class="column is-9">
    <% @venues_for_select = {"": ""}.merge(Entity.active.order(:name).to_h { |entity| [entity.id, entity.name] }) %>
    <%= select(:event, :venue_id, @venues_for_select, options = {class: 'select input is-success', value: @event.venue_id}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:event, :address, "address", options = {class: 'label'}) %>
    <p class="help">если venue не задан — адрес текстом</p>
  </div>

  <div class="column is-9">
    <%= input(:event, :address, options = {class: 'input is-success', value: @event.address, placeholder: "enter address"}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:event, :latitude, "latitude", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:event, :latitude, options = {class: 'input is-success', value: @event.latitude, placeholder: "enter latitude"}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:event, :longitude, "longitude", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:event, :longitude, options = {class: 'input is-success', value: @event.longitude, placeholder: "enter longitude"}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:event, :published, "published", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <input type="hidden" name="event[published]" value="0">
    <input type="checkbox" name="event[published]" value="1" <%= @event.published ? "checked" : "" %>>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:event, :active, "active", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <input type="hidden" name="event[active]" value="0">
    <input type="checkbox" name="event[active]" value="1" <%= @event.active ? "checked" : "" %>>
  </div>

</div>
