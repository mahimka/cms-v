<%= erb :'/layout/_flash', views: settings.views %>

<div class="content m-3">

  <h1 class="title"><%= @event.name %></h1>
  <p class="subtitle is-6">Step 2: остальные поля, details, tags, links и pictures.</p>

  <form method="POST" action="/admin/events/<%= @event.id %>">
    <input type="hidden" name="_method" value="PATCH">

    <%= erb :'/events/_form', views: settings.views_admin %>

    <%= erb :'/events/_details_fields', views: settings.views_admin %>

    <%= erb :'/events/_tags_fields', views: settings.views_admin %>

    <div class="field is-grouped">
      <div class="control">
        <input type="submit" value="Update Event" class="button is-link is-warning">
      </div>
      <div class="control">
        <a href="/admin/events/<%= @event.id %>" class="button">Show</a>
      </div>
    </div>

  </form>

  <%# отдельно от формы Event: у каждой ссылки/картинки свой ресурс/маршрут, %>
  <%# вложенные <form> в HTML невалидны %>
  <%= erb :'/events/_links_fields', views: settings.views_admin %>

  <%= erb :'/events/_pictures_fields', views: settings.views_admin %>

</div>
