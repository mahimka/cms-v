<%= erb :'/layout/_flash', views: settings.views %>

<form method="GET" action="/admin/events">

<div class="columns mb-0 ">
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">name_cont</p>
    <input class="input is-small" type="text" name="q[name_cont]" value="<%= @q.name_cont %>" placeholder="enter name">
  </div>
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">schema_name_cont</p>
    <input class="input is-small" type="text" name="q[schema_name_cont]" value="<%= @q.schema_name_cont %>" placeholder="">
  </div>
  <div class="column is-2">
    <p class="help is-size-7 has-text-weight-bold mt-0">venue_name_cont</p>
    <input class="input is-small" type="text" name="q[venue_name_cont]" value="<%= @q.venue_name_cont %>" placeholder="">
  </div>
</div>

<hr class="my-2">

<div class="columns is-mobile is-variable is-1 mb-0 is-size-7">
  <div class="column is-1">
    <input type="submit" value="Filter" class="button is-warning">
  </div>

  <div class="column is-1">
    <a href="/admin/events/new" class="button is-success">New</a>
  </div>

  <div class="column is-3">
    <h6 class="title is-size-6 mt-2">Found/Total: <%= @events_found.size %> / <%= Event.all.size %></h6>
  </div>
</div>

<hr class="my-0">

</form>


<div class="content is-size-7">
  <%= paginate(@events) %>
</div>

<div class="content">

  <table class="table is-size-7">
    <tr>
      <td></td>
      <td>name</td>
      <td>schema</td>
      <td>start_at</td>
      <td>venue</td>
      <td>tags</td>
      <td></td>
    </tr>

  <% @events.each do |event| %>

    <tr>
      <td><%= checkbox_in_place(event, :active) %></td>
      <td><%= event.name %></td>
      <td><%= event.schema&.name %></td>
      <td><%= event.start_at %></td>
      <td><%= event.venue&.name %></td>
      <td><%= event&.tags&.size %></td>

      <td>
        <a href="/admin/events/<%= event.id %>" class='button is-small'>show</a>
        <a href="/admin/events/<%= event.id %>/edit" class='button is-small'>edit</a>
      </td>
    </tr>

  <% end %>

  </table>

</div>
