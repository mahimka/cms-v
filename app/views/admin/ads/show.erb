<% if @ad.ancestors.any? %>
  <p>
    <a href="/admin/ads">Countries</a> /
    <% @ad.ancestors.each do |a| %>
      <a href="/admin/ads/<%= a.id %>"><%= a.name %> <span class="tag is-light is-small"><%= a.feature_code %></span></a> /
    <% end %>
  </p>
<% else %>
  <p><a href="/admin/ads">Countries</a></p>
<% end %>

<h1 class="title is-size-4"><%= @ad.name %> <span class="tag is-light"><%= @ad.feature_code %></span></h1>

<a href="/admin/ads/<%= @ad.id %>/edit" class="button is-small">edit</a>

<table class="table is-size-7">
  <tr>
    <td>id (geonameid)</td>
    <td><%= @ad.id %></td>
  </tr>
  <tr>
    <td>slug</td>
    <td><%= @ad.slug %></td>
  </tr>
  <tr>
    <td>country_code / admin1_code / admin2_code</td>
    <td><%= @ad.country_code %> / <%= @ad.admin1_code %> / <%= @ad.admin2_code %></td>
  </tr>
  <tr>
    <td>population</td>
    <td><%= @ad.population %></td>
  </tr>
  <tr>
    <td>latitude / longitude</td>
    <td><%= @ad.latitude %>, <%= @ad.longitude %></td>
  </tr>
  <tr>
    <td>timezone</td>
    <td><%= @ad.timezone %></td>
  </tr>
  <tr>
    <td>active</td>
    <td><%= checkbox_in_place(@ad, :active) %></td>
  </tr>
</table>

<h2 class='title is-4 mt-4'>tags linked to this ad</h2>
<ul>
  <% @ad.tags.each do |tag| %>
    <li><a href="/admin/tags/<%= tag.id %>"><%= tag.name %></a>
  <% end %>
</ul>

<h2 class="title is-size-5 mt-5">Children (<%= @ad.children.size %>)</h2>
<p class="help mb-3">клик по имени — раскрыть следующий уровень</p>

<%= erb :'/ads/_table', views: settings.views_admin, locals: { ads: @ad.children.order(:feature_code, :name) } %>
