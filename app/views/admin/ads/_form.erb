<% if @ad.new_record? %>
<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :id, "id", options = {class: 'label'}) %>
    <p class="help">geonameid с geonames.org — задаётся вручную, потом не меняется</p>
  </div>

  <div class="column is-9">
    <%= input(:ad, :id, options = {class: 'input is-success', value: @ad.id, placeholder: "enter geonameid"}) %>
  </div>

</div>
<% end %>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :parent_id, "parent_id", options = {class: 'label'}) %>
    <p class="help">родительское административное деление (например страна для региона)</p>
  </div>

  <div class="column is-9">
    <% @ads_for_select = {"": ""}.merge(Ad.where.not(id: @ad.id).order(:ancestry, :name).to_h { |ad| [ad.id, ("— " * ad.depth) + ad.name] }) %>
    <%= select(:ad, :parent_id, @ads_for_select, options = {class: 'select input is-success', value: @ad.parent_id}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :name, "name", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:ad, :name, options = {class: 'input is-success', value: @ad.name, placeholder: "enter name"}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :slug, "slug", options = {class: 'label'}) %>
    <p class="help">общий для всех проектов — не менять после публикации</p>
  </div>

  <div class="column is-9">
    <%= input(:ad, :slug, options = {class: 'input is-success', value: @ad.slug, placeholder: "enter slug"}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :feature_code, "feature_code", options = {class: 'label'}) %>
    <p class="help">geonames feature code — PCLI (страна), ADM1, ADM2, PPL... (город)</p>
  </div>

  <div class="column is-9">
    <%= input(:ad, :feature_code, options = {class: 'input is-success', value: @ad.feature_code, placeholder: "PCLI / ADM1 / ADM2 / PPL..."}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :country_code, "country_code", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:ad, :country_code, options = {class: 'input is-success', value: @ad.country_code}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :admin1_code, "admin1_code", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:ad, :admin1_code, options = {class: 'input is-success', value: @ad.admin1_code}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :admin2_code, "admin2_code", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:ad, :admin2_code, options = {class: 'input is-success', value: @ad.admin2_code}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :population, "population", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:ad, :population, options = {class: 'input is-success', value: @ad.population}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :latitude, "latitude / longitude", options = {class: 'label'}) %>
  </div>

  <div class="column is-4">
    <%= input(:ad, :latitude, options = {class: 'input is-success', value: @ad.latitude}) %>
  </div>

  <div class="column is-4">
    <%= input(:ad, :longitude, options = {class: 'input is-success', value: @ad.longitude}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :timezone, "timezone", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <%= input(:ad, :timezone, options = {class: 'input is-success', value: @ad.timezone}) %>
  </div>

</div>

<div class="columns">

  <div class="column is-2">
    <%= label(:ad, :active, "active", options = {class: 'label'}) %>
  </div>

  <div class="column is-9">
    <input type="hidden" name="ad[active]" value="0">
    <input type="checkbox" name="ad[active]" value="1" <%= @ad.active ? "checked" : "" %>>
  </div>

</div>
