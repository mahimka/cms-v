<table class="table is-size-7 is-bordered is-narrow">
  <tr class="has-text-weight-semibold">
    <td>active</td>
    <td>fc</td>
    <td>cc</td>
    <td>adm1</td>
    <td>adm2</td>
    <td>slug</td>
    <td>name</td>
    <td title="потомки по уровням: ADM1 / ADM2 / города (feature_code начинается с PPL)">descendants</td>
    <td>population</td>
    <td title="сколько тегов ссылается на этот ad через table/table_id">tags</td>
    <td></td>
  </tr>

  <% ads.each do |ad| %>
    <tr>
      <td><%= checkbox_in_place(ad, :active) %></td>
      <td nowrap><span class="tag is-danger is-small"><%= ad.feature_code %></span></td>
      <td nowrap><span class="tag is-success is-small"><%= ad.country_code %></span></td>
      <td nowrap><span class="tag is-warning is-small"><%= ad.admin1_code %></span></td>
      <td nowrap><span class="tag is-warning is-small"><%= ad.admin2_code %></span></td>
      <td nowrap><%= ad.slug %></td>
      <td nowrap><a href="/admin/ads/<%= ad.id %>"><%= ad.name %></a></td>
      <td nowrap>
        <% descendant_codes = ad.descendants.pluck(:feature_code) %>
        <div class="tags has-addons is-family-monospace mb-0">
          <span class="tag has-text-white has-background-grey-dark" title="ADM1 в потомках"><%= descendant_codes.count("ADM1") %></span>
          <span class="tag has-text-white has-background-grey" title="ADM2 в потомках"><%= descendant_codes.count("ADM2") %></span>
          <span class="tag has-background-white-bis" title="города (PPL*) в потомках"><%= descendant_codes.count { |fc| fc.to_s.start_with?("PPL") } %></span>
        </div>
      </td>
      <td nowrap><%= ad.population %></td>
      <td><%= ad.tags.size %></td>
      <td nowrap>
        <a href="/admin/ads/<%= ad.id %>" class="button is-small">show</a>
        <a href="/admin/ads/<%= ad.id %>/edit" class="button is-small">edit</a>
        <a href="/admin/ads/new?parent_id=<%= ad.id %>" class="button is-small is-info">+ child</a>
      </td>
    </tr>
  <% end %>
</table>
