<p><a class="button is-warning" href="/admin/labels/new">Add Label</a></p>

<div class="content m-3">

<form method="GET" action="/admin/labels">

  <div class="columns">
    <div class="column is-2">
      <tag class="tag is-size-7">name_cont</tag>
      <%= input(:q, :name_cont, options = {class: 'input is-small', value: @q.name_cont, placeholder: ""}) %>
    </div>
  </div>

  <div class="columns">
    <div class="column is-1">
      <input type="submit" value="Filter" class="button is-warning">
    </div>
    <div class="column is-11">
      Found/Total: <%= @labels_found %> / <%= Label.all.size %>
    </div>
  </div>

</form>

<div class="content">

  <div class="columns is-mobile is-variable is-1 mt-0 mb-0">
    <div class="column is-12">
      <%= paginate @labels unless @labels.blank? %>
    </div>
  </div>

  <table class="table is-narrow is-size-7">
    <tr class="is-size-6 has-text-weight-semibold">
      <td>active</td>
      <td title="запрещает менять name — на него ссылается List conditions">fixed 🔒</td>
      <td>icon</td>
      <td>name</td>
      <td>field_type</td>
      <td title="сколько раз используется в details">details</td>
      <td></td>
    </tr>

  <%# l.root? — корректно понимает формат ancestry "/" для root-узлов (Ancestry.default_ancestry_format = :materialized_path2 в app.rb).
      l.parent.nil? добавлен на случай истинного "осиротевшего" потомка (после удаления родителя) — тогда сам l становится своей группой, а не крашит страницу %>
  <% grouped_labels = @labels.group_by { |l| (l.root? || l.parent.nil?) ? l : l.parent } %>
  <% grouped_labels.sort_by { |group, _| [group.position || 0, group.name.to_s] }.each do |group, labels_in_group| %>

    <tr class="has-background-light">
      <td><%= checkbox_in_place(group, :active) %></td>
      <td><%= checkbox_in_place(group, :fixed) %></td>
      <td><span class="icon"><%= group.icon_svg %></span></td>
      <td class="has-text-weight-semibold"><%= group.name %></td>
      <td><%= group.field_type %></td>
      <td><%= @detail_counts_by_label[group.id] || 0 %></td>
      <td>
        <form method="POST" action="/admin/labels/<%= group.id %>/sort_children" style="display:inline;">
          <input type="hidden" name="by" value="string">
          <button type="submit" class="button is-small" title="сортировать детей группы по имени как строки">S</button>
        </form>
        <form method="POST" action="/admin/labels/<%= group.id %>/sort_children" style="display:inline;">
          <input type="hidden" name="by" value="float">
          <button type="submit" class="button is-small" title="сортировать детей группы по имени как числа (0.01, 0.5, 3, 44)">F</button>
        </form>
        <a href="/admin/labels/<%= group.id %>" class="button is-small">show</a>
        <a href="/admin/labels/<%= group.id %>/edit" class="button is-small">edit</a>
        <% if !group.active? && !group.fixed? %>
          <form method="POST" action="/admin/labels/<%= group.id %>" style="display:inline;" onsubmit="return confirm('Delete this label?')">
            <input type="hidden" name="_method" value="DELETE">
            <button type="submit" class="button is-small is-danger">delete</button>
          </form>
        <% else %>
          <button type="button" class="button is-small" disabled title="удалить можно только неактивный (active=false) и не fixed label">delete</button>
        <% end %>
      </td>
    </tr>

    <% (labels_in_group - [group]).sort_by { |l| [l.position || 0, l.name.to_s] }.each do |label| %>
      <tr>
        <td><%= checkbox_in_place(label, :active) %></td>
        <td><%= checkbox_in_place(label, :fixed) %></td>
        <td><span class="icon"><%= label.icon_svg %></span></td>
        <td class="pl-5"><%= label.name %></td>
        <td><%= label.field_type %></td>
        <td><%= @detail_counts_by_label[label.id] || 0 %></td>
        <td>
          <a href="/admin/labels/<%= label.id %>" class="button is-small">show</a>
          <a href="/admin/labels/<%= label.id %>/edit" class="button is-small">edit</a>
          <% if !label.active? && !label.fixed? %>
            <form method="POST" action="/admin/labels/<%= label.id %>" style="display:inline;" onsubmit="return confirm('Delete this label?')">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="button is-small is-danger">delete</button>
            </form>
          <% else %>
            <button type="button" class="button is-small" disabled title="удалить можно только неактивный (active=false) и не fixed label">delete</button>
          <% end %>
        </td>
      </tr>
    <% end %>

  <% end %>

  </table>

</div>

</div>
