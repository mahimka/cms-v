<p><a class="button is-warning" href="/admin/schemas/new">Add Schema</a></p>

<div class="content m-3">

<form method="GET" action="/admin/schemas">

  <div class="columns">
    <div class="column is-2">
      <tag class="tag is-size-7">name_cont</tag>
      <%= input(:q, :name_cont, options = {class: 'input is-small', value: @q.name_cont, placeholder: ""}) %>
    </div>
  </div>

  <div class="columns">
    <div class="column is-1">
      <input type="submit" value="Filter" class="button is-warning">
    </div>
    <div class="column is-11">
      Found/Total: <%= @schemas_found %> / <%= Schema.all.size %>
    </div>
  </div>

</form>

<div class="content">

  <div class="columns is-mobile is-variable is-1 mt-0 mb-0">
    <div class="column is-12">
      <%= paginate @schemas unless @schemas.blank? %>
    </div>
  </div>

  <table class="table is-narrow is-size-7">
    <tr class="is-size-6 has-text-weight-semibold">
      <td>active</td>
      <td>name</td>
      <td>slug</td>
      <td>tags</td>
      <td>labels</td>
      <td></td>
    </tr>

  <% @schemas.each do |schema| %>

    <tr>
      <td><%= checkbox_in_place(schema, :active) %></td>
      <td><%= ("— " * schema.depth) + schema.name %></td>
      <td><%= schema.slug %></td>
      <td><%= schema.tags.size %></td>
      <td><%= schema.labels.size %></td>
      <td>
        <a href="/admin/schemas/<%= schema.id %>" class="button is-small">show</a>
        <a href="/admin/schemas/<%= schema.id %>/edit" class="button is-small">edit</a>
      </td>
    </tr>

  <% end %>

  </table>

</div>

</div>
