<p>
  <a class="button is-warning" href="/admin/schemas/new">Add Schema</a>
  <form method="POST" action="/admin/schemas/export" style="display:inline;">
    <button type="submit" class="button is-info" title="все схемы, все колонки, в /schemas.json">Export</button>
  </form>
</p>

<div class="content m-3">

<form method="GET" action="/admin/schemas">

  <div class="columns">
    <div class="column is-2">
      <tag class="tag is-size-7">name_cont</tag>
      <%= input(:q, :name_cont, options = {class: 'input is-small', value: @q.name_cont, placeholder: ""}) %>
    </div>
  </div>

  <div class="columns">
    <div class="column is-1">
      <input type="submit" value="Filter" class="button is-warning">
    </div>
    <div class="column is-11">
      Found/Total: <%= @schemas_found %> / <%= Schema.all.size %>
    </div>
  </div>

</form>

<% if @q.name_cont.present? %>

  <%# Поиск — по дереву искать неудобно, выдаём обычный плоский список найденного. %>
  <div class="content">

    <div class="columns is-mobile is-variable is-1 mt-0 mb-0">
      <div class="column is-12">
        <%= paginate @schemas unless @schemas.blank? %>
      </div>
    </div>

    <table class="table is-narrow is-size-7">
      <tr class="is-size-6 has-text-weight-semibold">
        <td>active</td>
        <td title="запрещает менять name — на него ссылается List conditions (schema)">fixed 🔒</td>
        <td>name</td>
        <td>schema_org_url</td>
        <td>tags</td>
        <td>labels</td>
        <td></td>
      </tr>

    <% @schemas.each do |schema| %>

      <tr>
        <td><%= checkbox_in_place(schema, :active) %></td>
        <td><%= checkbox_in_place(schema, :fixed) %></td>
        <td><%= ("— " * schema.depth) + schema.name %></td>
        <td width=300><%= input_in_place(schema, :schema_org_url) %></td>
        <td><%= schema.tags.size %></td>
        <td><%= schema.labels.size %></td>
        <td>
          <a href="/admin/schemas/<%= schema.id %>" class="button is-small">show</a>
          <a href="/admin/schemas/<%= schema.id %>/edit" class="button is-small">edit</a>
        </td>
      </tr>

    <% end %>

    </table>

  </div>

<% else %>

  <%# Без активного поиска — дерево по ancestry, сортировка перетаскиванием внутри каждой группы (одного parent_id). %>
  <div class="content">
    <ul class="schema-children" data-parent-id="">
      <% Schema.roots.order(:position, :name).each do |root| %>
        <%= erb :'/schemas/_tree_node', locals: { schema: root }, views: settings.views_admin %>
      <% end %>
    </ul>
  </div>

  <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
  <script>
    $(function () {
      $('.schema-children').sortable({
        handle: '.icon-handle',
        placeholder: 'schema-drag-placeholder',
        forcePlaceholderSize: true,
        stop: function () {
          var ids = $(this).children('li').map(function () {
            return $(this).data('schema-id');
          }).get();

          $.post('/admin/schemas/reorder', { ids: ids });
        }
      }).disableSelection();
    });
  </script>

  <style>
    .schema-drag-placeholder {
      border: 2px dashed #ccc;
      border-radius: 4px;
      margin-bottom: 0.25rem;
      height: 2.5rem;
    }
  </style>

<% end %>

</div>
