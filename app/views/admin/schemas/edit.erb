<%= erb :'/layout/_flash', views: settings.views %>

<div class="content m-3">

  <h1 class="title"><%= @schema.name %></h1>

  <form method="POST" action="/admin/schemas/<%= @schema.id %>">
    <input type="hidden" name="_method" value="PATCH">

    <%= erb :'/schemas/_form', views: settings.views_admin %>

    <div class="field is-grouped">
      <div class="control">
        <input type="submit" value="Update Schema" class="button is-link is-warning">
      </div>
      <div class="control">
        <a href="/admin/schemas/<%= @schema.id %>" class="button">Show</a>
      </div>
      <div class="control">
        <a href="/admin/schemas/new?parent_id=<%= @schema.id %>" class="button is-info">+ child schema</a>
      </div>
    </div>

  </form>

</div>
