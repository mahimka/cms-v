<% profile = @snap_shot.profile %>
<% if profile %>
<h1 class='title is-4'>Profile</h1>
<table class='table is-size-7'>
	<tr>
		<td>url</td>
		<td><a href="<%= profile.url %>"><%= profile.url %></a></td>
	</tr>
	<tr>
		<td>scraped_at</td>
		<td><%= profile.active %> - <%= profile.status %> - <%= profile.scraped_at %> </td>
	</tr>
	<tr>
		<td>profileable_type</td>
		<td><%= profile.profileable_type %> - <%= profile.profileable_id ? "<a href='/admin/#{profile.profileable_type.parameterize.pluralize}/#{profile.profileable_id}'>SHOW</a>" : 'NO PRODCT' %></td>
	</tr>
	<tr>
		<td>redirected_to</td>
		<td><%= profile.redirected_to %></td>
	</tr>
</table>
<% else %>
<h1 class='title is-4'>Profile</h1>
<p>Профиль удалён (profile_id: <%= @snap_shot.profile_id %>)</p>
<% end %>

<h1 class='title is-4'>SnapShot</h1>
<table class='table is-size-7'>


	<tr>
		<td>title</td>
		<td><%= @snap_shot.title %></td>
	</tr>
	<tr>
		<td>h1</td>
		<td><%= @snap_shot.h1 %></td>
	</tr>
	<tr>
		<td>meta_description</td>
		<td><%= @snap_shot.meta_description %></td>
	</tr>
	<tr>
		<td>labels</td>
		<td><%= @snap_shot.labels %></td>
	</tr>
	<tr>
		<td>html_content</td>
		<td><%= @snap_shot.html_content&.length %></td>
	</tr>
	<tr>
		<td>param_1</td>
		<td><%= @snap_shot.param_1 %></td>
	</tr>
	<tr>
		<td>param_2</td>
		<td><%= @snap_shot.param_2 %></td>
	</tr>
	<tr>
		<td>param_3</td>
		<td><%= @snap_shot.param_3 %></td>
	</tr>
	<tr>
		<td>param_4</td>
		<td><%= @snap_shot.param_4 %></td>
	</tr>
	<tr>
		<td>param_5</td>
		<td><%= @snap_shot.param_5 %></td>
	</tr>
	<tr>
		<td>param_6</td>
		<td><%#= @snap_shot.param_6 %></td>
	</tr>
</table>




<%= @snap_shot.html_content %>

<%# @snap_shot.markers.each do |key, value| %>
  <p>
  	<strong><%#= key %></strong><br>
  	<%# if value.is_a? String %>
  	  <br>
  	  <%#= value %>
  	<%# elsif value.is_a? Array %>
  	  <ul>
  	  <%# value.each do |value| %>
  	    <li><%#= value %>
  	  <%# end %>
  	  </ul>
  	<%# end %>

  </p>
<%# end %>
