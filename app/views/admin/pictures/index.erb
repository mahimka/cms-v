<p><a class="button is-warning" href="/admin/pictures/new">Add Picture</a></p>

<div class="content m-3">

<form method="GET" action="/admin/pictures">

  <div class="columns">
    <div class="column is-2">
      <tag class="tag is-size-7">imageable_type_eq</tag>
      <% @imageable_types_for_select = {"": ""}.merge(PicturesController::IMAGEABLE_TYPES.to_h { |type| [type, type] }) %>
      <%= select(:q, :imageable_type_eq, @imageable_types_for_select, options = {class: 'select input is-small', value: @q.imageable_type_eq}) %>
    </div>
    <div class="column is-2">
      <tag class="tag is-size-7">alt_cont</tag>
      <%= input(:q, :alt_cont, options = {class: 'input is-small', value: @q.alt_cont, placeholder: ""}) %>
    </div>
    <div class="column is-2">
      <tag class="tag is-size-7">tags_name_cont</tag>
      <%= input(:q, :tags_name_cont, options = {class: 'input is-small', value: @q.tags_name_cont, placeholder: ""}) %>
    </div>
  </div>

  <div class="columns">
    <div class="column is-1">
      <input type="submit" value="Filter" class="button is-warning">
    </div>
    <div class="column is-11">
      Found/Total: <%= @pictures_found %> / <%= Picture.all.size %>
    </div>
  </div>

</form>

<div class="content">

  <div class="columns is-mobile is-variable is-1 mt-0 mb-0">
    <div class="column is-12">
      <%= paginate @pictures unless @pictures.blank? %>
    </div>
  </div>

  <table class="table is-narrow is-size-7">
    <tr class="is-size-6 has-text-weight-semibold">
      <td>active</td>
      <td>preview</td>
      <td>imageable</td>
      <td>alt</td>
      <td>tags</td>
      <td>ratio</td>
      <td></td>
    </tr>

  <% @pictures.each do |picture| %>

    <tr>
      <td><%= checkbox_in_place(picture, :active) %></td>
      <td><img src="<%= picture.file %>" alt="<%= picture.alt %>" style="max-height: 40px;"></td>
      <td>
        <% if picture.imageable %>
          <a href="/admin/<%= picture.imageable.class.name.underscore.pluralize %>/<%= picture.imageable.id %>">
            <%= picture.imageable_type %> #<%= picture.imageable_id %>
          </a>
        <% else %>
          <%= picture.imageable_type %> #<%= picture.imageable_id %>
        <% end %>
      </td>
      <td><%= picture.alt %></td>
      <td><%= picture.tags.map(&:name).join(', ') %></td>
      <td><%= picture.ratio %></td>
      <td>
        <a href="/admin/pictures/<%= picture.id %>" class="button is-small">show</a>
        <a href="/admin/pictures/<%= picture.id %>/edit" class="button is-small">edit</a>
      </td>
    </tr>

  <% end %>

  </table>

</div>

</div>
