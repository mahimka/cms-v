<table class="table is-narrow">
  <%# GscStat.where(page: @page.url).first(1).each do |page| %>
    <tr>
      <!--<td><%#= page.page_id %></td>-->
      <td><%#= page.clicks %></td>
      <td><%#= page.impressions %></td>
      <td><%#= page.position %></td>
      <td><%#= page.page %></td>
      <td><%#= page.query %></td>
      <td><%#= page.stat_date %></td>
      <!--<td><%#= page.ctr %></td>-->
    </tr>
  <%# end %>
</table>

<style>
   .label {
      font-size:0.75em;
      margin: 0.6em  0 0.2em  0.2em ;
   }  
   .column {
      padding:0 0.15em 0.1em 0;
   }
   .input, .textarea {
      font-size:0.75em;
      margin: 0 0.2em  0 0.2em;
   }
   .icon {
      font-size:0.75em; 
   }

   hr {
    padding: 0em;
    margin: 0.1em 0 1.5em 0; 
   }

</style>

<div class="box py-2 px-3 mb-3 is-size-7">

  <div>
    <strong>URL:</strong>
    <% if @page.uri == "/" %>
      <a href="https://<%= settings.domain %><%= @page.uri %>" target="_blank"><strong>/</strong></a>
    <% else %>
      <% uri_prefix, _, uri_slug = @page.uri.rpartition("/") %>
      <a href="https://<%= settings.domain %><%= @page.uri %>" target="_blank"><%= uri_prefix %>/<strong><%= uri_slug %></strong></a>
    <% end %>
    <% unless @page.published? %>
      <span class="tag is-small is-light" title="Ссылка выше может вести на 404 — страница ещё не опубликована">draft</span>
    <% end %>
  </div>

  <% if @page.template.present? %>
    <div>
      <strong>Template:</strong>
      <a href="/admin/page_templates/<%= @page.template_id %>/edit">#<%= @page.template_id %> — <%= @page.template.slug %></a>
      (<a href="/admin/pages?<%= Rack::Utils.build_nested_query("q" => { "template_id_eq" => @page.template_id }) %>">все страницы этого template'а</a>)
      <% if @page.edited_columns.present? %>
        — вручную отредактированы (и защищены от force refresh): <%= @page.edited_columns.join(", ") %>
      <% end %>
    </div>
  <% end %>

  <% if @page.pageable.present? %>
    <div>
      <strong><%= @page.effective_pageable_type %>:</strong>
      <% if pageable_edit_url(@page) %>
        <a href="<%= pageable_edit_url(@page) %>">#<%= @page.pageable_id %> — <%= @page.pageable.name %></a>
      <% else %>
        #<%= @page.pageable_id %> — <%= @page.pageable.name %>
      <% end %>
    </div>
  <% elsif @page.effective_conditions.present? %>
    <div>
      <strong>conditions:</strong> <code><%= @page.effective_conditions.to_json %></code>
    </div>
  <% end %>

</div>

<input id="hidden" type="hidden" name="page[id]" value="<%= @page.id %>">

<div class="columns">
  <div class="column is-1">
     <%= checkbox_in_place @page, :ready %>ready
  </div>

  <div class="column is-2">
    <%= checkbox_in_place @page, :published %> published
  </div>
</div>

<%# uri вычисляется автоматически из slug и родителя — вручную не редактируется.
    Смена родителя — только в дереве (_tree_edit_form.erb). %>
<% if @page.master? %>
  <div class="columns">
    <div class="column is-1">
      <%= label(:page, :slug, "slug", options = {class: 'label'}) %> <%= page_field_lock(@page, "slug") %>
    </div>
    <div class="column is-11">
      <%= input_in_place @page, :slug %>
    </div>
  </div>
<% end %>

<div class="columns">
  <div class="column is-1">
  </div>

  <%# view/layout — из Page::MASTER_ONLY_FIELDS, у перевода не заполняются %>
  <% if @page.master? %>
    <div class="column is-2">
      <%= label(:page, :layout, "layout:", options = {class: 'label mb-0'}) %> <%= page_field_lock(@page, "layout") %>
      <% values = Dir.glob("**", base: "app/views/layout") %>
      <%= select_in_place @page, :layout, values %>
    </div>

    <div class="column is-2">
      <%= label(:page, :view, "view:", options = {class: 'label mb-0'}) %> <%= page_field_lock(@page, "view") %>
      <% values = Dir.glob("*.*", base: "app/views").sort %>
      <%= select_in_place @page, :view, values %>
    </div>
  <% end %>

  <div class="column is-2">

    <label class="label mb-0" for="page_has_feed">has_feed: </label>

    <%= checkbox_in_place @page, :has_feed %>

  </div>

</div>



<hr>




<div class="columns">
  <div class="column is-1"><%= label(:page, :title, "title", options = {class: 'label'}) %> <%= page_field_lock(@page, "title") %></div>
  <div class="column is-11"><%= input_in_place @page, :title %></div>
</div>

<div class="columns">
  <div class="column is-1"><%= label(:page, :h1, "h1", options = {class: 'label'}) %> <%= page_field_lock(@page, "h1") %></div>
  <div class="column is-11"><%= input_in_place @page, :h1 %></div>
</div>

<div class="columns">
  <div class="column is-1"><%= label(:page, :subtitle, "subtitle", options = {class: 'label'}) %> <%= page_field_lock(@page, "subtitle") %></div>
  <div class="column is-11"><%= input_in_place @page, :subtitle %></div>
</div>

<div class="columns">
  <div class="column is-1"><%= label(:page, :meta_description, "meta_d", options = {class: 'label'}) %> <%= page_field_lock(@page, "meta_description") %></div>
  <div class="column is-11"><%= textarea_in_place @page, :meta_description %></div>
</div>

<div class="columns">
  <div class="column is-1"><%= label(:page, :anchors, "anchors", options = {class: 'label'}) %></div>
  <div class="column is-4">
    <%= page_field_lock(@page, "anchor_1") %>
    <%= input_in_place @page, :anchor_1 %>
  </div>
  <div class="column is-4">
    <%= page_field_lock(@page, "anchor_2") %>
    <%= input_in_place @page, :anchor_2 %>
  </div>
  <div class="column is-3">
    <%= page_field_lock(@page, "anchor_3") %>
    <%= input_in_place @page, :anchor_3 %>
  </div>
</div>

<div class="columns">
  <div class="column is-1"><%= label(:page, :body, "body", options = {class: 'label'}) %> <%= page_field_lock(@page, "body") %></div>
  <div class="column is-11">
    <%= textarea_in_place @page, :body %>
  </div>
</div>

<div class="columns">
  <div class="column is-1"><%= label(:page, :schema, "schema", options = {class: 'label'}) %> <%= page_field_lock(@page, "schema") %></div>
  <div class="column is-11">
    <%= textarea_in_place @page, :schema %>
  </div>  
</div>

<div class="columns">
  <div class="column is-1"><%= label(:page, :faq, "faq", options = {class: 'label'}) %> <%= page_field_lock(@page, "faq") %></div>
  <div class="column is-11">
    <%= textarea_in_place @page, :faq %>
  </div>
</div>

<% %w[hero_1 hero_2 hero_3 sidebar_1 sidebar_2 sidebar_3 footer_1 footer_2 footer_3
     block_1 block_2 block_3 block_4 block_5 block_6].each do |column| %>
  <div class="columns">
    <div class="column is-1"><%= label(:page, column, column, options = {class: 'label'}) %> <%= page_field_lock(@page, column) %></div>
    <div class="column is-11">
      <%= textarea_in_place @page, column.to_sym %>
    </div>
  </div>
<% end %>








