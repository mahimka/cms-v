<div class="pages-workspace">
  <aside class="pages-tree-panel">
    <header class="pages-tree-header">

      <% unless Page.exists?(
           uri: "/",
           master_id: nil,
           lang: settings.home_language
         ) %>
        <form
          method="post"
          action="/admin/pages/setup-root"
          class="mb-4"
        >
          <button
            type="submit"
            class="button is-danger is-small"
          >
            Создать корневую страницу
          </button>
        </form>
      <% end %>

    </header>

    <div class="pages-tree-scroll is-size-7" id="pages-tree">
      <%= erb :"/pages/_tree",
              layout: false,
              views: settings.views_admin %>
    </div>
  </aside>

  <main class="page-editor-panel" id="page-editor">
    <div class="page-editor-placeholder">
      <h2>Выберите страницу</h2>

      <p>
        Нажмите на URI страницы в дереве, чтобы открыть форму редактирования.
      </p>
    </div>
  </main>
</div>

<script src="/admin/javascripts/pages-tree.js"></script>
<script src="/admin/javascripts/page-body-mentions.js"></script>

<style>
.pages-workspace {
  display: grid;
  grid-template-columns: minmax(200px, 22%) minmax(0, 1fr);
  min-height: 600px;
  border: 1px solid #dbdbdb;
  border-radius: 4px;
}

.pages-tree-panel {
  display: flex;
  min-width: 0;
  flex-direction: column;
  border-right: 1px solid #dbdbdb;
}

.pages-tree-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.75rem;
}

.pages-tree-header:empty,
.pages-tree-header:not(:has(*)) {
  display: none;
}

.pages-tree-header h1 {
  margin: 0;
  font-size: 1.1rem;
}

.tree-new-page {
  white-space: nowrap;
}

.pages-tree-scroll {
  flex: 1;
  padding: 0.75rem;
  overflow: auto;
  max-height: 90vh;
}

.page-tree,
.page-tree-children {
  margin: 0;
  padding: 0;
  list-style: none;
}

ul.page-tree-children {
  margin-left: 0.85rem;
  padding-left: 0.6rem;
  border-left: 1px solid #dbdbdb;
}

ul.page-tree-children[hidden] {
  display: none;
}

.page-tree-row {
  display: grid;
  grid-template-columns: 1.5rem 1.2rem minmax(0, 1fr) 0.7rem;
  align-items: center;
  gap: 0.25rem;
  min-height: 1.8rem;
}

.page-tree-type {
  text-align: center;
  font-size: 0.7rem;
  height: 1.2rem;
  padding: 0 0.3rem;
}

.page-tree-toggle,
.page-tree-toggle-placeholder {
  width: 1.4rem;
  height: 1.4rem;
}

.page-tree-toggle {
  padding: 0;
  border: 1px solid #dbdbdb;
  border-radius: 3px;
  background: transparent;
  color: inherit;
  cursor: pointer;
  line-height: 1;
}

.page-tree-toggle:hover {
  background: #f5f5f5;
}

.page-tree-toggle.is-loading {
  opacity: 0.4;
}

.page-tree-link {
  margin: 0;
  padding: 0.15rem 0.4rem;
  border: 0;
  border-radius: 3px;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-tree-link:hover {
  background: #f5f5f5;
}

.page-tree-link.is-selected {
  background: #eef6fc;
  box-shadow: inset 3px 0 0 #3273dc;
  font-weight: 700;
}

.page-tree-status {
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
}

.page-tree-status.is-published {
  background: #2f9e44;
}

.page-tree-status.is-draft {
  border: 1px solid #b5b5b5;
}

.page-tree-more {
  padding: 0.2rem 0 0.2rem 3rem;
  font-style: italic;
}

.page-tree-more-link {
  color: inherit;
}

.page-editor-panel {
  min-width: 0;
  overflow: auto;
}

.page-editor-placeholder {
  display: grid;
  min-height: 100%;
  padding: 2rem;
  place-content: center;
  color: var(--pico-muted-color);
  text-align: center;
}

.page-editor-content {
  padding: 1.5rem;
}

.page-editor-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--pico-muted-border-color);
}

.page-editor-header h2 {
  margin-bottom: 0.25rem;
}

.page-editor-header p {
  margin: 0;
  color: var(--pico-muted-color);
}

.page-editor-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1.5rem;
}

@media (max-width: 900px) {
  .pages-workspace {
    display: block;
    height: auto;
  }

  .pages-tree-panel {
    max-height: 45vh;
    border-right: 0;
    border-bottom: 1px solid #dbdbdb;
  }

  .page-editor-panel {
    min-height: 50vh;
  }
}


</style>