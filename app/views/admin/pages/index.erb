          method="post"
          action="/admin/pages/setup-root"
        >
          <button
            type="submit"
            class="button is-danger is-small"
          >
            Создать корневую страницу
          </button>
        </form>
      <% end %>

      </div>

    </div>

    <hr class="my-0">

</div>    

</form>


<div class="content is-size-7">
  <%= paginate(@pages) %>
</div> 

<div class="content">

  <table class="table is-size-7">
    <tr>
      <td></td>
      <!--<td>id</td>-->
      <!--<td>lang_ref</td>-->
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <!--
      <td>title</td>
      <td>h1</td>
      <td>sub</td>
      <td>anchor_1</td>
      <td>anchor_2</td>
      <td>anchor_3</td>
      <td>category</td>
      <td>item</td>
      <td>view</td>
      -->
    </tr> 

  <% @pages.each do |page| %>

    <%# is_base_page = page.base_page.blank? %>
    <%# is_base_page %>
    <%# disabled = is_base_page ? "" : "pointer-events: none; background-color: lightgrey;" %>
    
    <tr>
      <!--<td><%= page.id %></td>-->
      <!--<td width='50'><%#= input_in_place page, :lang_ref %></td>-->


      <td><%= page.lang %></td>
      <td><a href='/admin/pages/<%= page.id %>/edit-in-place' class="button is-small">edit</a></td>
      <td><%= page.master_id %></td>

  <!--    <td><%= checkbox_in_place page, :ready %></td> 
      <td><%= checkbox_in_place page, :published %></td> 

      <td><%#= page.pictures.length %></td>
      
      <td><a href="/admin/pages/<%= page.id %>/edit-in-place" class='button is-small'>edit</a></td>
      <td><a href="/admin/pages/new?source_page_id=<%= page.id %>&sub=true" class='button is-small is-warning'>sub</a></td>
      <td><a href="/admin/pages/new?source_page_id=<%= page.id %>&copy=true" class='button is-small is-warning'>copy</a></td>
  -->
      <td><a href='<%= page.uri %>'><%= page.uri %></a></td>
      <td width=370><%= input_in_place page, :title %></td>
      <td width=370><%= input_in_place page, :h1 %></td>
      <td width=370><%= input_in_place page, :subtitle %></td>
      <td width=370><%= input_in_place page, :anchor_1 %></td>
      <td width=370><%= input_in_place page, :anchor_2 %></td>

      <% values = (Dir.glob("**", base: settings.views_project) + Dir.glob("**", base: settings.views))
                    .delete_if{|file| !file.ends_with?(".erb") || file.starts_with?("_")}.uniq.sort.unshift("") %>
      <td width=170><%= select_in_place(page, :view, values, class: 'input is-success is-small mt-1') %></td>

      <!--
      <td><%#= input_in_place page, :h1 %></td>
      <td><%#= input_in_place page, :subtitle %></td>
      <td><%#= input_in_place page, :anchor_1 %></td>
      <td><%#= input_in_place page, :anchor_2 %></td>
      <td><%#= input_in_place page, :anchor_3 %></td>
      -->

      <td>
          <%#= select_in_place page, :category, Page::PAGE_CATEGORIES, style: 'disabled' %> 
      </td>    

      <td>
        <% #values = Item.all.to_h {|item| [item.id, item.ancestors_and_item]} %>
        <%#= select_in_place page, :item_id, values, style: 'disabled' %> 
      </td>

      <td>
        <%# values = Dir.glob("*.*", base: "app/views").sort %>
        <%#= select_in_place page, :view, values, style: 'disabled' %>
      </td>

    </tr>   
  
  <% end %>

  </table>  

</div>

</div>

