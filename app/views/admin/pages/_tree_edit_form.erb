<section class="section">
  <%# Шапка формы %>
  <div class="level mb-5">
    <div class="level-left">
      <div>
        <h2 class="title is-6 mb-2">
          <label class="checkbox ">
            <input type="checkbox"
              name="page[ready]"
              value="1"
              <%= "checked" if @page.ready? %>
            >
            <span class="is-size-7 has-text-weight-light">ready</span>
          </label>

          <label class="checkbox ">
            <input type="checkbox"
              name="page[published]"
              value="1"
              <%= "checked" if @page.published? %>
            >
            <span class="is-size-7 has-text-weight-light">published</span>
          </label>

          <a href='<%= @page.uri %>' target='_blank'><%= @page.uri %></a>

        </h2>

        <p class="subtitle is-7 text-muted">
          <span class="tag is-info is-light"><%= @page.lang %></span>

          <% if @page.master? %>
            <span class="tag is-info is-light">master page</span>
          <% else %>
            <span class="tag is-info is-light">
              · перевод страницы      
            </span> <code><%= @page.master.uri %></code>
          <% end %>
          
          <% if @page.pageable_type && @page.pageable_id %>
            <a href='/admin/<%= @page.pageable_type.pluralize.parameterize %>/<%= @page.pageable_id %>/edit'><span class="tag is-light"><%= @page.pageable_type %> : <%= @page.pageable_id %></span></a>
          <% end %>
          <label class="checkbox ">
            <input type="checkbox"
              name="page[published]"
              value="1"
              <%= "checked" if @page.has_feed? %>
            >
            <span class="is-size-7 has-text-weight-light">feed</span>
          </label>

        </p>



      </div>
    </div>

    <div class="level-right">
<!--
      <button
        type="button"
        class="button is-light is-small"
        data-page-edit
        data-page-id="<%= @page.id %>"
      >
        Edit fix на Отдельную
      </button>
-->



      <% if @page.master? %>

          <button
            type="button"
            class="button is-warning is-small"
            data-page-sub
            data-source-page-id="<%= @page.id %>"
          >
            Sub
          </button>

          <button
            type="button"
            class="button is-warning is-small"
            data-page-copy
            data-source-page-id="<%= @page.id %>"
          >
            Dup
          </button>

      <% end %>
      <a href='/admin/pages/<%= @page.id %>/edit-in-place' class="button is-light is-small">Edit in Place</a>

    </div>

  </div>

  <% if @page.errors.any? %>
    <div class="notification is-danger is-light">
      <ul>
        <% @page.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <form
      method="post"
      action="/admin/pages/<%= @page.id %>"
      data-page-edit-form
    >
    <input type="hidden" name="_method" value="patch">

    <%# Блок системных полей (только для master-страницы) %>
    <% if @page.master? %>
      <div class="field">
        <label class="label is-small">Языки</label>

        <div class="buttons">
          <% settings.languages.each do |lang_code, lang_info| %>
            <% lang_code = lang_code.to_s %>

            <% if lang_code == @page.lang %>
              <button
                type="button"
                class="button is-small is-link"
                disabled
                title="<%= lang_info[:name] %> (текущий язык)"
              >
                <%= lang_code.upcase %>
              </button>
            <% else %>
              <% translation = @page.version_for(lang_code) %>

              <% if translation %>
                <button
                  type="button"
                  class="button is-small is-success is-light"
                  data-page-lang-open
                  data-target-page-id="<%= translation.id %>"
                  title="Открыть перевод: <%= lang_info[:name] %>"
                >
                  <%= lang_code.upcase %>
                </button>
              <% else %>
                <button
                  type="button"
                  class="button is-small is-light"
                  data-page-lang-create
                  data-source-page-id="<%= @page.id %>"
                  data-lang="<%= lang_code %>"
                  title="Создать перевод: <%= lang_info[:name] %>"
                >
                  <%= lang_code.upcase %>
                </button>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>

<div class="columns">
  <div class="column is-6">

        <label class="label is-small">Родительская страница</label>

            <select name="page[parent_id]" class="input is-small">
              <option value="">Корневая страница</option>

              <% @parent_pages.each do |parent_page| %>
                <option value="<%= parent_page.id %>" <%= "selected" if @page.parent_id == parent_page.id %> >
                  <%= parent_page.uri %>
                </option>
              <% end %>
            </select>

  </div>
  <div class="column is-3">

      <%= label(:page, :layout, "layout:", options = {class: 'label is-small'}) %>
      <% values = Dir.glob("**", base: "project/views/layout").delete_if{|file| file.starts_with?("_")}.unshift("") %>
      <%= select(:page, :layout, values, options = {class: 'select input is-success is-size-7', value: @page.layout}) %>

  </div>
  <div class="column is-3">

      <%= label(:page, :view, "view:", options = {class: 'label is-small'}) %>
      <% values = Dir.glob("**", base: "project/views").delete_if{|file| !file.ends_with?(".erb") || file.starts_with?("_")}.unshift("") %>
      <%= select(:page, :view, values, options = {class: 'select input is-success is-size-7', value: @page.view}) %>

  </div>
</div>

  <div class="columns">

    <div class="column is-1">
      <label class="label is-small">slug</label>
    </div>

    <div class="column is-11">
      <input
          class="input is-small"
          type="text"
          name="page[slug]"
          value="<%= @page.slug %>"
          <%= "required" if @page.non_root_master? %>
        >
    </div>
  </div>

    <div class="field is-grouped mt-0 pt-0">
        <button type="submit" class="button is-danger is-small has-text-white">
          Save
        </button>
    </div>
      <div class="columns">


<!--
        <div class="column">

            <label class="label is-small">layout</label>
            <div class="control">
              <input
                class="input is-small"
                type="text"
                name="page[layout]"
                value="<%#= @page.layout %>"
              >
      
          </div>
        </div>
-->

      </div>


<% if @page.pageable_type.blank? %>

      <div class="field">
        <label class="label is-small">
          conditions (страница-список)
        </label>
        <p class="help">

        </p>
        <div class="control">
          <textarea
            class="textarea is-size-7"
            name="page[conditions]"
            rows="5"

            placeholder=
"object: Entity | Item | Event | Picture<br>
tags: ['and'|'or', ...] / ['not', left, right] — вложенно<br>
schema: slug из Schema (с потомками по иерархии)<br>
start_at / end_at: только для Event<br>
details: {'key': 'value'}"
            style="font-family: monospace;"
          ><%= @page.conditions.presence ? JSON.pretty_generate(@page.conditions) : '' %></textarea>
        </div>
      </div>
    <% end %>
<% end %>
    <%# Основной контент страницы %>


    <div class="columns">
      <div class="column is-1">
        <label class="label is-small">title</label>
      </div>
      <div class="column is-11">
        <input
            class="input is-small"
            type="text"
            name="page[title]"
            value="<%= @page.title %>"
          >
      </div>
    </div>
    
    <div class="columns">
      <div class="column is-1">
        <label class="label is-small">h1</label>
      </div>
      <div class="column is-11">
        <input
            class="input is-small"
            type="text"
            name="page[h1]"
            value="<%= @page.h1 %>"
          >
      </div>
    </div>

    <div class="columns">
      <div class="column is-1">
        <label class="label is-small">subtitle</label>
      </div>
      <div class="column is-11">
        <input
            class="input is-small"
            type="text"
            name="page[subtitle]"
            value="<%= @page.subtitle %>"
          >
      </div>
    </div>

    <div class="columns">
      <div class="column is-1">
        <label class="label is-small">anchors</label>
      </div>
      <div class="column is-3">
        <input
            class="input is-small"
            type="text"
            name="page[anchor_1]"
            value="<%= @page.anchor_1 %>"
          >
      </div>
      <div class="column is-4">
        <input
            class="input is-small"
            type="text"
            name="page[anchor_2]"
            value="<%= @page.anchor_2 %>"
          >
      </div>
      <div class="column is-4">
        <input
            class="input is-small"
            type="text"
            name="page[anchor_3]"
            value="<%= @page.anchor_3 %>"
          >
      </div>
    </div>

    <div class="field">
      <label class="label is-small">meta_description</label>
      <div class="control">
        <textarea
          class="textarea"
          name="page[meta_description]"
          rows="4"
        ><%= @page.meta_description %></textarea>
      </div>
    </div>

    <div class="field">
      <label class="label is-small">body</label>
      <div class="control">
        <textarea
          class="textarea"
          name="page[body]"
          rows="16"
        ><%= @page.body %></textarea>
      </div>
    </div>

    <br>

    <hr class="dropdown-divider my-5">

    <%# SEO поля %>


    <%# Кнопки действия %>
    <div class="field is-grouped mt-5 pt-3">
      <div class="control">
        <button type="submit" class="button is-danger is-small has-text-white">
          Save
        </button>
      </div>
    </div>
  </form>
</section>