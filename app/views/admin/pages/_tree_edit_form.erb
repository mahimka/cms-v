      </div>
      <div class="column is-4">
        <%= translate_field_button(@page, "anchor_3") %>
        <input
            class="input is-small ml-3"
            type="text"
            name="page[anchor_3]"
            value="<%= @page.anchor_3 %>"
          >
      </div>
    </div>

    <div class="field">
      <label class="label is-small">meta_description</label>
      <%= translate_field_button(@page, "meta_description") %>
      <div class="control">
        <textarea
          class="textarea autosize-textarea"
          name="page[meta_description]"
          rows="1"
        ><%= @page.meta_description %></textarea>
      </div>
    </div>

    <div class="field">
      <label class="label is-small">body</label>
      <%= translate_field_button(@page, "body") %>
      <div class="control">
        <textarea
          class="textarea autosize-textarea"
          name="page[body]"
          rows="1"
        ><%= @page.body %></textarea>
      </div>
    </div>


    <div class="field">
      <label class="label is-small">faq</label>
      <%= translate_field_button(@page, "faq") %>
      <div class="control">
        <textarea
          class="textarea autosize-textarea"
          name="page[faq]"
          rows="1"
        ><%= @page.faq %></textarea>
      </div>
    </div>


    <div class="field">
      <label class="label is-small">schema</label>
      <div class="control">
        <textarea
          class="textarea autosize-textarea"
          name="page[schema]"
          rows="1"
        ><%= @page.schema %></textarea>
      </div>
    </div>

    <% [:hero_1, :hero_2, :hero_3, 
        :sidebar_1, :sidebar_2, :sidebar_3,
        :footer_1, :footer_2, :footer_3,
        :block_1, :block_2, :block_3, :block_4
       ].each do |column| 
    %>

      <div class="field">
        <label class="label is-small"><%= column %></label>
        <%= translate_field_button(@page, column) %>
        <div class="control">
          <textarea
            class="textarea autosize-textarea"
            name="page[<%= column %>]"
            rows="1"
          ><%= @page.send(column) %></textarea>
        </div>
      </div>
    <% end %>


    <style>
      #page-editor textarea.autosize-textarea {
        min-height: 2em;
        overflow-y: hidden;
      }
    </style>

    <script>
      (function () {
        function autosize(el) {
          el.style.height = 'auto';
          el.style.height = el.scrollHeight + 'px';
        }

        $('#page-editor textarea.autosize-textarea').each(function () {
          autosize(this);
        });

        // Форма перезагружается через AJAX при каждом открытии страницы —
        // .off перед .on, чтобы не плодить одинаковые делегированные
        // обработчики на document с каждой перезагрузкой партиала.
        $(document)
          .off('input.autosize-textarea')
          .on('input.autosize-textarea', '#page-editor textarea.autosize-textarea', function () {
            autosize(this);
          });
      })();
    </script>

    <br>

    <hr class="dropdown-divider my-5">

    <%# SEO поля %>


    <%# Кнопки действия %>
    <div class="field is-grouped mt-5 pt-3">
      <div class="control">
        <button type="submit" class="button is-danger is-small has-text-white">
          Save
        </button>
      </div>
    </div>
  </form>
</section>