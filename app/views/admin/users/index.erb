<p><a class="button is-warning" href="/admin/users/new">Add User</a></p>

<div class="content m-3">

<form method="GET" action="/admin/users">

  <div class="columns">
    <div class="column is-2">
      <tag class="tag is-size-7">name_cont</tag>
      <%= input(:q, :name_cont, options = {class: 'input is-small', value: @q.name_cont, placeholder: ""}) %>
    </div>
    <div class="column is-2">
      <tag class="tag is-size-7">email_cont</tag>
      <%= input(:q, :email_cont, options = {class: 'input is-small', value: @q.email_cont, placeholder: ""}) %>
    </div>
  </div>

  <div class="columns">
    <div class="column is-1">
      <input type="submit" value="Filter" class="button is-warning">
    </div>
    <div class="column is-11">
      Found/Total: <%= @users_found %> / <%= User.all.size %>
    </div>
  </div>

</form>

<div class="content">

  <div class="columns is-mobile is-variable is-1 mt-0 mb-0">
    <div class="column is-12">
      <%= paginate @users unless @users.blank? %>
    </div>
  </div>

  <table class="table is-narrow is-size-7">
    <tr class="is-size-6 has-text-weight-semibold">
      <td>name</td>
      <td>email</td>
      <td>pictures</td>
      <td>created_at</td>
      <td></td>
    </tr>

    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.pictures.size %></td>
        <td><%= user.created_at %></td>
        <td>
          <a href="/admin/users/<%= user.id %>/edit" class="button is-small">edit</a>
        </td>
      </tr>
    <% end %>

  </table>

</div>

</div>
