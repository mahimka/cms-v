<% content_for :hero do %>
    <% if partial('_carousel').blank? %>
        <section class="hero is-medium has-background-grey-lighter  mt-0 pb-0">
          <div class="hero-body">
            <div class="container">

              <div class="columns is-vcentered">

                <div class="column is-6">
             
                  <h1 class="title is-size-2 has-text-grey-dark"><%= @page.h1 %></h1>
                  <p class='subtitle mt-3'><%= @page.subtitle %></p>
        
                  <%= @page.hero_1.blank? ? yield_content(:hero_1) : @page.hero_1 %>
                  <%= @page.hero_2.blank? ? yield_content(:hero_2) : @page.hero_2 %>
                  <%= @page.hero_3.blank? ? yield_content(:hero_3) : @page.hero_3 %>
                
                </div>

                <div class="column is-6">
                  <%#= partial '_picture_pageable' %>
                </div>

              </div>
            </div>
          </div>
        </section>
                         
    <% else %>

      <section class="hero is-medium" style="position: relative; overflow: hidden;">
        <%= partial '_carousel' %>
        <%= partial '_carousel_overlay' %>
        <%#= partial '_carousel_div_hero' %>

        <!-- Контент Hero поверх карусели -->
        <div class="hero-body" style="position: relative; z-index: 2;">
          <div class="container">

            <h1 class="title is-2 has-text-white mb-1">
              <%= @page.h1 %> 
            </h1>

            <% unless @page.subtitle.blank? %>
              <p class='subtitle has-text-white mt-0' style="opacity: 0.82; max-width: 640px; ">
                <%= @page.subtitle %>
              </p>
            <% end %>

            <% unless @page.hero_1.blank? %>
              <p class='is-6 subtitle has-text-white mt-0' style="opacity: 0.82; max-width: 640px; ">
                <%= @page.hero_1 %>
              </p>
            <% end %>

            <% unless @page.hero_2.blank? %>
              <p class='is-6 subtitle has-text-white mt-0' style="opacity: 0.82; max-width: 640px; ">
                <%= @page.hero_2 %>
              </p>
            <% end %>

            <% if @page.hero_3.blank? %>
            <% else %>
              <div class="buttons">
                <%= parse_erb_and_markdown @page.hero_3 %>
              </div>
              <%= partial('_share_buttons') %>
            <% end %>

          </div>
        </div> 

      </section>

    <% end %>

<% end %> 