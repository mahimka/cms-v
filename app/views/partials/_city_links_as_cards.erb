
<div class="columns is-multiline">


<% link = link_to("#{city_page_uri}/eateries/restaurants") %>
<% href = link[/href="([^"]+)"/, 1] %>
<% unless href.nil? || href == '' %>
	<div class="column">
	  <a href="<%= href %>" class="box">
	    <p class="title is-5 mb-2 mt-0">
           <%= "#{label_by_lang_with_icon('_restaurants')} 
           <span class='is-size-7 tag has-text-weight-light'>
             #{count_profile_pages("#{city_page_uri}/eateries", view='profile_restaurant.erb')}
           </span>" %>
	    </p>
        <%#= href %>
	  </a>
	</div>
<% end %>

