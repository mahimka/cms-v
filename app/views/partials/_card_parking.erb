<div class="card diversorio">

  <% if page %>
    <a href="<%= page.uri %>">
  <% end %>

    <% if picture %>
      <div class="card-image">
        <figure class="image is-4by3">
          <img src="<%= asset_path(picture.file) %>" loading="lazy" alt="<%= picture.translation(@page.lang) %>" style="object-fit: cover;">
        </figure>
      </div>
    <% end %>

  <% if page %>
    </a>
  <% end %>

  <div class="card-content">
    <p class="title is-size-6">
      <% if page %>
        <a href="<%= page.uri %>"><%= page.anchor_1.presence || object.name %> </a> <%= tags_by_group("addressLocality", page: page) %>
      <% else %>
        <%= object.name %>
      <% end %>
    </p>

    <%= detail_by_label('rate_high', page: page, only_value: true) %> €

    <p class="subtitle mt-3 is-7 has-text-grey">
      <%= tag_by_lang('Electric Charger', page: page) %>
      <%= tag_by_lang('Motorhome', page: page) %>
      <%= tags_by_group("parking rates", page: page) %>
      <%= tags_by_group("payment features", page: page, limit: 3) %>
    </p>
  </div>


</div>







