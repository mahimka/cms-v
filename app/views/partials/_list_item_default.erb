<%
  # Picture — сам по себе картинка, ссылки на отдельную страницу нет.
  # У Entity/Item/Event есть has_many :pages, as: :pageable — берём
  # версию на языке текущей страницы-списка.
  target_page = object.respond_to?(:pages) ? object.pages.find_by(lang: @page.lang) : nil

  picture =
    if object.is_a?(Picture)
      object
    elsif object.respond_to?(:pictures)
      object.pictures.published.first
    end
%>



<% if target_page&.pageable&.schema&.name == 'Beach' %>
  <%= partial '_card_beach', page: target_page, picture: picture, object: object %>
<% elsif target_page&.pageable&.schema&.name == 'ParkingFacility' %>
  <%= partial '_card_parking', page: target_page, picture: picture, object: object %>
<%# elsif target_page.pageable.schema.name == 'Parking' %>
  <%#= partial '_card_parking', page: target_page, picture: picture %>
<%# elsif target_page.pageable.schema.name == 'Parking' %>
  <%#= partial '_card_parking', page: target_page, picture: picture %>
<%# elsif target_page.pageable.schema.name == 'Parking' %>
  <%#= partial '_card_parking', page: target_page, picture: picture %>
<%# elsif target_page.pageable.schema.name == 'Parking' %>
  <%#= partial '_card_parking', page: target_page, picture: picture %>
<% else %>


<div class="card">

<% if target_page %>
<a href="<%= target_page.uri %>">
<% end %>

<% if picture %>
<div class="card-image">
<figure class="image is-4by3">
<img src="<%= picture.file %>" loading="lazy" alt="<%= picture.translation(@page.lang) %>" style="object-fit: cover;">
</figure>
</div>
<% end %>

<% if target_page %>
</a>
<% end %>

<div class="card-content">
<p class="title is-size-5">
<% if target_page %>
<a href="<%= target_page.uri %>"><%= target_page.h1.presence || object.name %></a>
<% else %>
<%= object.name %>
<% end %>
</p>
</div>

</div>

<% end %>