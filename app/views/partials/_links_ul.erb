<ul style='list-style-type: none;' class='m-0 p-0 mt-2 mb-0 is-size-7' >


  <% if @page_links['website'] %>
    <li>
      <a href="<%= @page_links['website'] %>" target="_blank" rel="noopener noreferrer nofollow">
        <span class="icon-text">
          <%= label_icon("website") %><%= @page_links['website'].split('/').last %>
        </span>
      </a>
    </li>
  <% end %>

