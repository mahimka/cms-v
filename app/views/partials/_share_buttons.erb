<div class="buttons share-buttons-white">

  <!-- WhatsApp -->
  <a class="button is-rounded share-btn--wa is-size-7 is-mobile" 
     href="https://wa.me/?text=<%= URI.encode_www_form_component(@page.title) -%>%20https%3A%2F%2F<%= settings.domain -%><%= @page.uri -%>"
     target="_blank" 
     rel="noopener" 
     aria-label="WhatsApp" 
     title="WhatsApp">
    <span class="icon">
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.1.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.7-.9-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1.1 1-1.1 2.5s1.1 2.9 1.3 3.1c.2.3 2.2 3.3 5.3 4.7.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.5.3-.7.3-1.4.2-1.5-.1-.1-.3-.2-.6-.3zm-5.5 7.5h-.1c-1.7 0-3.3-.5-4.8-1.3l-.3-.2-3.5.9.9-3.4-.2-.4c-.9-1.5-1.4-3.3-1.4-5.1 0-5.3 4.3-9.6 9.6-9.6 2.6 0 4.9 1 6.7 2.8 1.8 1.8 2.8 4.2 2.8 6.7 0 5.4-4.4 9.6-9.7 9.6zm8.2-17.8C18.1 2 15.1.7 12 .7 5.5.7.2 6 .2 12.5c0 2.1.5 4.1 1.6 5.9L.1 24l5.8-1.5c1.7 1 3.7 1.4 5.7 1.4h.1c6.5 0 11.8-5.3 11.8-11.8-.1-3.2-1.3-6.1-3.5-8.3z"></path></svg>
    </span>
  </a>

  <!-- Facebook -->
  <a class="button is-rounded share-btn--fb is-size-7" 
     href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2F<%= settings.domain -%><%= @page.uri -%>" 
     target="_blank" 
     rel="noopener" 
     aria-label="Facebook" 
     title="Facebook">
    <span class="icon">
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M9.19 21.5v-8.16H6.61v-3.2h2.58V7.9c0-2.55 1.55-3.95 3.82-3.95 1.09 0 2.03.08 2.3.12v2.67H13.73c-1.24 0-1.48.59-1.48 1.45v1.9h2.95l-.38 3.2h-2.57v8.2"></path></svg>
    </span>
  </a>

  <!-- X / Twitter -->
  <a class="button is-rounded share-btn--x is-size-7 is-hidden-touch" 
     href="https://twitter.com/intent/tweet?text=<%= URI.encode_www_form_component(@page.title) -%>&url=https%3A%2F%2F<%= settings.domain -%><%= @page.uri -%>"
     target="_blank" 
     rel="noopener" 
     aria-label="X" 
     title="X">
    <span class="icon">
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
    </span>
  </a>

  <!-- Telegram -->
  <a class="button is-rounded share-btn--tg is-size-7" 
     href="https://t.me/share/url?url=https%3A%2F%2F<%= settings.domain -%><%= @page.uri -%>&text=<%= URI.encode_www_form_component(@page.title) -%>"
     target="_blank" 
     rel="noopener" 
     aria-label="Telegram" 
     title="Telegram">
    <span class="icon">
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"></path></svg>
    </span>
  </a>

  <!-- Pinterest -->
  <a class="button is-rounded share-btn--pi is-size-7 is-hidden-touch" 
     href="https://pinterest.com/pin/create/button/?url=https%3A%2F%2F<%= settings.domain -%><%= @page.uri -%>&description=<%= URI.encode_www_form_component(@page.title) -%>"
     target="_blank" 
     rel="noopener" 
     aria-label="Pinterest" 
     title="Pinterest">
    <span class="icon">
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 0C5.4 0 0 5.4 0 12c0 5.1 3.2 9.4 7.6 11.2-.1-.9-.2-2.4 0-3.4.2-.9 1.4-5.7 1.4-5.7s-.4-.7-.4-1.8c0-1.7 1-3 2.2-3 1 0 1.5.8 1.5 1.7 0 1-.7 2.6-1 4.1-.3 1.2.6 2.2 1.8 2.2 2.2 0 3.8-2.3 3.8-5.6 0-2.9-2.1-5-5.1-5-3.5 0-5.5 2.6-5.5 5.3 0 1 .4 2.2.9 2.8.1.1.1.2.1.3-.1.3-.3 1.2-.3 1.4 0 .2-.2.3-.4.2-1.4-.7-2.3-2.7-2.3-4.4 0-3.6 2.6-6.9 7.5-6.9 3.9 0 7 2.8 7 6.5 0 3.9-2.5 7.1-5.9 7.1-1.2 0-2.3-.6-2.7-1.3l-.7 2.8c-.3 1-1 2.3-1.4 3.1.9.3 1.9.4 2.9.4 6.6 0 12-5.4 12-12S18.6 0 12 0z"></path></svg>
    </span>
  </a>

  <!-- Email -->
  <a class="button is-rounded share-btn--email is-size-7" 
     href="mailto:?subject=<%= URI.encode_www_form_component(@page.title) -%>&body=<%= URI.encode_www_form_component(@page.title) -%>%0A%0Ahttps%3A%2F%2F<%= settings.domain -%><%= @page.uri -%>"
     target="_blank" 
     rel="noopener" 
     aria-label="Email" 
     title="Email">
    <span class="icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
    </span>
  </a>
  <!-- Copy Link -->
<!--
  <button class="button is-rounded share-btn--copy" 
          aria-label="Copy link" 
          title="Copy link" 
          data-share-copy="https://<%= settings.domain -%><%= @page.uri -%>">
    <span class="icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
    </span>
  </button>
-->
</div>

<script>
/* Белые кружки с мягкой тенью */
.share-buttons-white .button {
  width: 42px;
  height: 42px;
  padding: 0;
  border: none;
  background-color: #ffffff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  transition: all 0.25s ease;
}

/* При наведении: приподнимаем и делаем тень глубже */
.share-buttons-white .button:hover {
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
}

/* Цвета иконок */
.share-btn--wa { color: #25d366; }
.share-btn--fb { color: #1877f2; }
.share-btn--x  { color: #111111; }
.share-btn--tg { color: #24a1de; }
.share-btn--pi { color: #e60023; }
.share-btn--email,
.share-btn--copy { color: #666666; }
</script>